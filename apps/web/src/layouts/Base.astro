---
const { title = "LLM Architecture Atlas" } = Astro.props;
interface Props {
  title?: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global>
      :root {
        --paper: #f5f7fa;
        --ink: #172033;
        --muted: #5d6778;
        --line: rgb(145 157 177 / 26%);
        --attention: #1769e0;
        --state: #008c8c;
        --compute: #d9822b;
        --conflict: #c94f5c;
        --panel: #ffffff;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "Source Sans 3", "Noto Sans SC", system-ui, sans-serif;
        line-height: 1.6;
      }
      main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      a {
        color: var(--attention);
      }
      .eyebrow {
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #0b1220;
          color: #e6ebf4;
        }
      }
    </style>
  </head>
  <body>
    <div class="langbar">
      <button id="lang-toggle" type="button" aria-label="切换语言 / switch language">中文</button>
    </div>
    <main>
      <slot />
    </main>
    <script>
      import "../scripts/i18n";
    </script>
    <style>
      .langbar { max-width: 72rem; margin: 0 auto; padding: 0.8rem 1.25rem 0; display: flex; justify-content: flex-end; }
      #lang-toggle {
        font: inherit; font-size: 0.85rem; font-weight: 700; cursor: pointer;
        border: 1px solid var(--line); border-radius: 8px; background: var(--panel); color: inherit;
        padding: 0.3rem 0.8rem;
      }
      #lang-toggle:hover { border-color: var(--attention); }
    </style>
  </body>
</html>
