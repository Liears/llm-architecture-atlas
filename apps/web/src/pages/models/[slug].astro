      border-color: color-mix(in srgb, var(--attention) 55%, transparent);
      background: color-mix(in srgb, var(--attention) 6%, transparent);
    }
    .hotspot:focus-visible,
    .hotspot.active {
      outline: none;
      border-color: var(--attention);
      background: color-mix(in srgb, var(--attention) 10%, transparent);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--attention) 25%, transparent);
    }

    .subview-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 0.5rem;
      padding: 0.55rem 0.85rem;
      border-radius: 10px;
