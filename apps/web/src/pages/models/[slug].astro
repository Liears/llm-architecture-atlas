        margin-bottom: 0.2rem;
      }
      .meta-line {
        font-size: 0.74rem;
      }
      .section {
        margin-bottom: 1.35rem;
      }
      .section-bar {
        gap: 0.4rem;
        margin-bottom: 0.45rem;
      }
      .stage-heading {
        gap: 0.3rem;
      }
      .stage-heading h2 {
        font-size: 1.02rem;
      }
      .view-tabs {
        gap: 0.25rem;
      }
      .vtab {
        padding: 0.22rem 0.52rem;
        font-size: 0.75rem;
        min-height: 26px;
      }
      .vbtn {
        padding: 0.24rem 0.52rem;
        font-size: 0.75rem;
        min-height: 26px;
      }
      .mobile-cards .section-bar,
      .mobile-cards .small-note {
        display: none;
      }
      .reading-cards-grid {
        gap: 0.45rem;
        margin-top: 0;
      }
      .reading-card {
        padding: 0.6rem 0.8rem;
      }
      .reading-card .eyebrow {
        margin-bottom: 0.15rem;
        font-size: 0.68rem;
      }
      .spine-chain {
        margin-top: 0.1rem;
        font-size: 0.86rem;
        line-height: 1.35;
      }
      .schedule-pills {
        margin-top: 0.2rem;
        font-size: 0.8rem;
        gap: 0.15rem;
      }
      .mobile-subview-triggers {
        margin-top: 0.45rem;
        gap: 0.35rem;
      }
      .m-sub-btn {
        min-height: 26px;
        padding: 0.25rem 0.55rem;
        font-size: 0.76rem;
      }
      /* #38 mobile citation table: stack each row cleanly with zero horizontal scroll */
      .evidence thead {
        display: none;
      }
      .evidence,
      .evidence tbody,
      .evidence tr,
      .evidence td {
        display: block;
        width: 100%;
      }
      .evidence tr {
        padding: 0.6rem 0.7rem;
        border-bottom: 1px solid var(--line);
      }
      .evidence td {
        border: 0;
        padding: 0.18rem 0;
        overflow-wrap: anywhere;
      }
      .evidence td::before {
        content: attr(data-label) ": ";
