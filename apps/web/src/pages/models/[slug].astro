---
import Base from "../../layouts/Base.astro";
import { loadModels } from "../../lib/atlas.js";
import { buildCatalog, buildGenome, genomeCellRole, formatParams, formatContext } from "@atlas/catalog";
import {
  buildScheduleRuns,
  compileForModel,
  compileLayerBlockSubview,
  compileModuleSubview,
  positionForModel,
  type CompiledSubview,
} from "@atlas/diagram-engine";
import { renderSvg } from "@atlas/renderer-svg";

export function getStaticPaths() {
  const all = loadModels();
  return all.map((m, idx) => ({ params: { slug: m.slug }, props: { model: m, index: idx, allModels: all } }));
}

const { model, index, allModels } = Astro.props;
const { arch, evidence, brief } = model;
const facts = arch.facts;
const genome = buildGenome(arch);
const [entry] = buildCatalog([arch]);
const isSystemOne = entry!.paradigm === "system_one_decision";
const dh = arch.topology.decision_head;

const roleColor: Record<string, string> = {
  attention: "var(--attention)",
  state: "var(--state)",
  compute: "var(--compute)",
  muted: "var(--line)",
};

const attnGroups = arch.topology.attention_groups;
const ffnGroups = arch.topology.ffn_groups;
const attnLabels = attnGroups.map((g) => g.label);
const ffnLabels = ffnGroups.map((g) => g.label);

const statusSymbol = (s: string) =>
  s === "verified" ? "✓" : s === "reported" ? "•" : s === "derived" ? "=" : s === "inferred" ? "?" : s === "conflict" ? "!" : "?";

const otherOptions = allModels
  .map((m, i) => ({
    slug: m.slug,
    label: m.arch.model.label,
    pairUrl:
      i < index
        ? `/llm-architecture-atlas/compare/${m.slug}--vs--${model.slug}/`
        : `/llm-architecture-atlas/compare/${model.slug}--vs--${m.slug}/`,
  }))
  .filter((o) => o.slug !== model.slug);

const statusCounts = evidence.claims.reduce<Record<string, number>>((acc, c) => {
  acc[c.status] = (acc[c.status] ?? 0) + 1;
  return acc;
}, {});

const scheduleRuns = buildScheduleRuns(facts.num_hidden_layers, attnGroups, ffnGroups);

const spineSummary = isSystemOne
  ? dh?.readout_mode === "mask_marker_mlp"
    ? ["State + Typed Q", "Token + Type Emb", `${facts.num_hidden_layers}L Encoder`, `${dh.head_layers ?? 2}L Decision Head`, "Calibrated Scorer", "Typed JSON"]
    : ["State + Image + Q", "Embed + Vision", `${facts.num_hidden_layers}L Hybrid`, "1-Step Prefill", "Letter Logits + T", "Typed JSON"]
  : ["Token ids", "Token embedding", `${facts.num_hidden_layers}L Decoder`, "Final RMSNorm", "LM head"];

const attnSummaryStr = attnGroups.map((g) => `${g.layers.length} ${g.label}`).join(" + ");
const ffnSummaryStr = ffnGroups.map((g) => `${g.layers.length} ${g.label}`).join(" → ");
const archSummaryLine = isSystemOne
  ? `${facts.num_hidden_layers}-layer non-autoregressive System-1 encoder (${attnSummaryStr}; readout: ${dh?.readout_mode ?? "decision head"}) · ${formatParams(facts.total_params)} params.`
  : `${facts.num_hidden_layers}-layer autoregressive decoder (${attnSummaryStr}; ${ffnSummaryStr}${arch.topology.residual?.scheme === "mhc" ? `; ${arch.topology.residual.streams}-stream mHC` : ""}) · ${formatParams(facts.total_params)}${facts.active_params && facts.active_params !== facts.total_params ? ` / ${formatParams(facts.active_params)} active` : ""}.`;

// Build-time overview hotspot boxes + real compiled per-layer & module subviews (#36, #37)
const overviewScene = compileForModel(arch, evidence);
const { positioned: overviewPos } = positionForModel(overviewScene);

interface OverviewHotspot {
  id: string;
  label: string;
  detail?: string;
  claimPaths: string[];
  xPct: number;
  yPct: number;
  wPct: number;
  hPct: number;
}

const overviewHotspots: OverviewHotspot[] = overviewPos.nodes
  .map((box) => {
    const sem = overviewScene.nodes.find((n) => n.id === box.id);
    if (!sem) return null;
    const paths = new Set<string>();
    if (sem.claimPath) paths.add(sem.claimPath);
    for (const c of sem.claims ?? []) paths.add(c.claimPath);
    if (paths.size === 0) return null;
    return {
      id: sem.id,
      label: sem.label,
      ...(sem.detail ? { detail: sem.detail } : {}),
      claimPaths: [...paths],
      xPct: Number(((box.x / overviewPos.size.w) * 100).toFixed(3)),
      yPct: Number(((box.y / overviewPos.size.h) * 100).toFixed(3)),
      wPct: Number(((box.w / overviewPos.size.w) * 100).toFixed(3)),
      hPct: Number(((box.h / overviewPos.size.h) * 100).toFixed(3)),
    };
  })
  .filter((x): x is OverviewHotspot => x !== null);

const subviews: Record<string, { title: string; subtitle: string; svg: string }> = {};
const layerToSubviewKey: Record<string, string> = {};

const renderSub = (sub: CompiledSubview) => {
  subviews[sub.key] = {
    title: sub.title,
    subtitle: sub.subtitle,
    svg: renderSvg(sub.positioned, { title: `${arch.model.label} — ${sub.title}`, showTitle: true }),
  };
};

// Module subviews
for (const modKind of ["attention", "ffn", "residual"] as const) {
  renderSub(compileModuleSubview(arch, evidence, modKind));
}
if (isSystemOne && dh) {
  renderSub(compileModuleSubview(arch, evidence, "decision"));
}

// Per-layer block subviews compiled once per distinct (attention, ffn, tail) class
for (let i = 0; i < facts.num_hidden_layers; i++) {
  const blockSub = compileLayerBlockSubview(arch, evidence, i);
  layerToSubviewKey[String(i)] = blockSub.key;
  if (!subviews[blockSub.key]) {
    renderSub(blockSub);
  }
}

const evidencePayload = {
  model: arch.model,
  ir_version: arch.ir_version,
  paradigm: entry!.paradigm,
  claims: evidence.claims,
  brief: brief ?? null,
};
---

<Base title={`${arch.model.label} — LLM Architecture Atlas`} active="detail">
  <div class="crumb-row">
    <a class="crumb-back" href="/llm-architecture-atlas/" data-i18n="detail.backCatalog">← Catalog</a>
    <div class="crumb-meta">
      <span class={`pill ${isSystemOne ? "pill-s1" : "pill-ar"}`}>
        {isSystemOne ? "System-1 · Non-Autoregressive" : "System-2 · Autoregressive"}
      </span>
      <span class="pill">{arch.model.family ?? "Other"}</span>
      {arch.model.license && <span class="pill mono">{arch.model.license}</span>}
    </div>
  </div>

  <header class="detail-head">
    <div class="head-copy">
      <h1>{arch.model.label}</h1>
      <p class="arch-summary">{archSummaryLine}</p>
      <p class="muted meta-line">
        <span data-i18n="detail.generatedFrom">Architecture IR</span> {arch.ir_version} ·
        <span data-i18n="detail.revision">Revision</span> <code class="rev-chip">{arch.model.revision}</code> ·
        <a href="https://github.com/Liears/llm-architecture-atlas/issues" data-i18n="detail.reportCorrection">Report correction</a>
      </p>
    </div>

    <div class="compare-picker">
      <select id="compare-target" aria-label="Compare with another model">
        <option value="" data-i18n="detail.compareWith">Compare with…</option>
        {otherOptions.map((o) => <option value={o.pairUrl}>{o.label}</option>)}
      </select>
    </div>
  </header>

  <section class="section stage-section" aria-label="Architecture diagram explorer">
    <div class="section-bar">
      <div class="stage-heading">
        <h2 data-i18n="detail.overview">Architecture Plate</h2>
        <div class="view-tabs" role="tablist" aria-label="Architecture subviews">
          <button type="button" role="tab" aria-selected="true" class="vtab active" data-subview="overview" data-i18n="detail.viewOverview">Overview</button>
          <button type="button" role="tab" aria-selected="false" class="vtab" data-subview="attention" data-i18n="detail.viewAttn">Attention</button>
          <button type="button" role="tab" aria-selected="false" class="vtab" data-subview="ffn" data-i18n="detail.viewFfn">MoE / FFN</button>
          <button type="button" role="tab" aria-selected="false" class="vtab" data-subview="residual" data-i18n="detail.viewResidual">Residual</button>
          {isSystemOne && dh && (
            <button type="button" role="tab" aria-selected="false" class="vtab" data-subview="decision" data-i18n="detail.viewDecision">Decision</button>
          )}
          <button type="button" role="tab" aria-selected="false" class="vtab" id="tab-block" data-subview="block">
            <span data-i18n="detail.viewBlock">Layer Block</span> <span id="tab-block-idx" class="mono">L0</span>
          </button>
        </div>
      </div>

      <div class="canvas-controls" role="toolbar" aria-label="Diagram zoom and export controls">
        <button type="button" id="reset-overview-btn" class="btn btn-subtle" hidden data-i18n="detail.resetOverview">Back to Overview</button>
        <div class="view-modes" role="group" aria-label="Zoom mode">
          <button type="button" class="vbtn active" data-view-mode="fit" data-i18n="detail.fitView">Fit</button>
          <button type="button" class="vbtn" data-view-mode="pan" data-i18n="detail.scrollView">1:1 Pan</button>
          <button type="button" class="vbtn" data-view-mode="zoom" data-i18n="detail.zoomView">135%</button>
        </div>
        <div class="export-btns">
          <a class="btn" href={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`} download data-i18n="detail.downloadSvg">Download SVG</a>
          <button type="button" class="btn png-btn" data-fig={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`} data-name={model.slug} data-i18n="detail.downloadPng">Download PNG</button>
          <button type="button" class="btn copy-svg-btn" data-fig={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`} data-i18n="detail.copySvg">Copy SVG</button>
          <button type="button" id="export-manifest-btn" class="btn" data-name={model.slug} data-i18n="detail.exportManifest">Manifest</button>
        </div>
      </div>
    </div>

    <div class="stage-body">
      <div id="overview-stage">
        <div id="figure-wrap" class="figure-wrap mode-fit" data-atlas-scroll="x" tabindex="0" aria-label="Scrollable interactive architecture figure">
          <div class="figure-inner">
            <img
              class="diagram-img"
              src={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`}
              alt={`Architecture overview of ${arch.model.label}, generated from the Architecture IR`}
            />
            <div class="hotspot-layer" aria-label="Interactive diagram node claims">
              {overviewHotspots.map((hs) => (
                <button
                  type="button"
                  class="hotspot"
                  style={`left:${hs.xPct}%;top:${hs.yPct}%;width:${hs.wPct}%;height:${hs.hPct}%`}
                  data-node-id={hs.id}
                  data-claim-paths={hs.claimPaths.join(",")}
                  data-label={hs.label}
                  data-detail={hs.detail ?? ""}
                  aria-label={`${hs.label}${hs.detail ? `: ${hs.detail}` : ""} — inspect citation`}
                  title={`${hs.label}${hs.detail ? ` (${hs.detail})` : ""}`}
                />
              ))}
            </div>
          </div>
        </div>
      </div>

      <div id="subview-stage" class="subview-stage" hidden data-testid="subview-stage">
        <div class="subview-banner">
          <div>
            <strong id="subview-title"></strong>
            <span id="subview-subtitle" class="muted mono"></span>
          </div>
          <span class="muted small-hint">Click any node for source citation · Esc returns to overview</span>
        </div>
        <div id="subview-canvas" class="figure-wrap mode-fit" data-atlas-scroll="x" tabindex="0"></div>
      </div>

      <!-- Mobile first-screen structured reading overview (#36): avoids tiny 105px desktop thumbnail -->
      <section class="mobile-cards" aria-label="Structured reading breakdown">
        <div class="section-bar">
          <div>
            <h3 data-i18n="detail.mobileBreakdown">Mobile Structured Overview</h3>
            <p class="muted small-note" data-i18n="detail.mobileBreakdownNote">
              Readable execution spine, repeating layer schedule, and interactive subsystem entry points.
            </p>
          </div>
        </div>
        <div class="reading-cards-grid">
          <article class="reading-card">
            <span class="eyebrow">Main Execution Spine</span>
            <p class="spine-chain">{spineSummary.join(" → ")}</p>
          </article>
          <article class="reading-card">
            <span class="eyebrow">Layer Schedule · {facts.num_hidden_layers}L</span>
            <ul class="schedule-pills">
              {scheduleRuns.map((r) => (
                <li><strong>{r.label}</strong>: <span class="mono">{r.detail}</span></li>
              ))}
            </ul>
            <div class="mobile-subview-triggers">
              <button type="button" class="btn m-sub-btn" data-jump-subview="attention">Attention diagram →</button>
              <button type="button" class="btn m-sub-btn" data-jump-subview="ffn">MoE / FFN diagram →</button>
              <button type="button" class="btn m-sub-btn" data-jump-subview="block">Inspect L0 block →</button>
            </div>
          </article>
          {isSystemOne && dh && (
            <article class="reading-card reading-card-s1">
              <span class="eyebrow">System-1 Readout & Calibration</span>
              <p class="mini-note">{dh.note}</p>
            </article>
          )}
        </div>
      </section>
    </div>
  </section>

  <section class="section">
    <h2 data-i18n="detail.factSheet">Technical Specification</h2>
    <dl class="facts">
      <button type="button" class="fact-btn" data-claim-paths="facts.num_hidden_layers" data-label="Layers"><dt data-i18n="fact.layers">Layers</dt><dd class="mono">{facts.num_hidden_layers}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.hidden_size" data-label="Hidden dim"><dt data-i18n="fact.hiddenSize">Hidden dim</dt><dd class="mono">{facts.hidden_size.toLocaleString("en-US")}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.num_attention_heads,facts.num_key_value_heads,facts.head_dim" data-label="Attn / KV heads"><dt data-i18n="fact.heads">Attn / KV heads</dt><dd class="mono">{facts.num_attention_heads}{facts.num_key_value_heads ? ` · KV ${facts.num_key_value_heads}` : ""}{facts.head_dim ? ` · d=${facts.head_dim}` : ""}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.vocab_size" data-label="Vocab size"><dt data-i18n="fact.vocab">Vocab size</dt><dd class="mono">{facts.vocab_size?.toLocaleString("en-US") ?? "—"}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.context_tokens" data-label="Context"><dt data-i18n="fact.context">Context</dt><dd class="mono">{formatContext(facts.context_tokens)}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.total_params,facts.active_params" data-label="Parameters"><dt data-i18n="fact.params">Parameters</dt><dd class="mono">{facts.total_params ? `${formatParams(facts.total_params)} total` : "—"}{facts.active_params && facts.active_params !== facts.total_params ? ` / ${formatParams(facts.active_params)} active` : ""}</dd></button>
    </dl>
  </section>

  {isSystemOne && dh && (
    <section class="section decision-panel">
      <h2 data-i18n="detail.decisionSpec">System-1 Decision Contract</h2>
      <dl class="facts">
        <button type="button" class="fact-btn" data-claim-paths="topology.decision_head.readout_mode" data-label="Readout mode">
          <dt data-i18n="detail.readoutMode">Readout mode</dt>
          <dd class="mono">{dh.readout_mode}</dd>
        </button>
        <button type="button" class="fact-btn" data-claim-paths="topology.decision_head.primitives" data-label="Typed primitives">
          <dt data-i18n="detail.primitives">Typed primitives</dt>
          <dd class="mono">{dh.primitives?.join(", ") || "—"}</dd>
        </button>
        <button type="button" class="fact-btn" data-claim-paths="topology.decision_head.calibration" data-label="Calibration">
          <dt data-i18n="detail.calibration">Calibration</dt>
          <dd class="mono">{dh.calibration ?? "—"}</dd>
        </button>
        <button type="button" class="fact-btn" data-claim-paths="topology.decision_head.action_head,topology.decision_head.max_options,topology.decision_head.prefix_cache,topology.decision_head.vision_encoder" data-label="Execution features">
          <dt data-i18n="detail.extras">Execution features</dt>
          <dd class="mono">
            {[
              dh.head_layers ? `${dh.head_layers}L head` : null,
              dh.action_head ? dh.action_head : null,
              dh.max_options ? `≤${dh.max_options} opts/pass` : null,
              dh.prefix_cache ? "Prefix KV cache" : null,
              dh.vision_encoder ? dh.vision_encoder : null,
            ]
              .filter(Boolean)
              .join(" · ") || "Single forward pass"}
          </dd>
        </button>
      </dl>
      {dh.note && <p class="muted decision-note">{dh.note}</p>}
    </section>
  )}

  <section class="section">
    <div class="section-bar">
      <div>
        <h2 data-i18n="detail.genome">Layer Genome & Drill-Down</h2>
        <p class="muted small-note" data-i18n="detail.genomeNote">
          Click or use ← / → keys on any layer column to load its module block diagram and linked citations.
        </p>
      </div>
      <button type="button" id="clear-layer" class="btn" hidden data-i18n="detail.clearLayer">Clear layer</button>
    </div>

    <div class="genome" data-atlas-scroll="x" role="listbox" aria-label={`Per-layer genome: ${genome.numLayers} layers. Arrow keys move, Enter selects.`} tabindex="0">
      {genome.layers.map((l) => {
        const aMod = attnGroups.find((g) => g.label === l.attention)?.module ?? l.attentionKind;
        const fMod = ffnGroups.find((g) => g.label === l.ffn)?.module ?? l.ffnKind;
        return (
          <button
            type="button"
            class="col"
            role="option"
            aria-selected="false"
            data-layer={String(l.index)}
            data-attention={l.attention}
            data-attn-kind={l.attentionKind}
            data-attn-module={aMod}
            data-ffn={l.ffn}
            data-ffn-kind={l.ffnKind}
            data-ffn-module={fMod}
            title={`layer ${l.index}: attention ${l.attention} · ffn ${l.ffn}`}
          >
            <span class="cell" style={`background:${roleColor[genomeCellRole(l)]}`} />
            <span class="cell ffn" style={`background:${l.ffnKind === "moe" ? "var(--compute)" : isSystemOne ? "var(--decision)" : "var(--line)"}`} />
          </button>
        );
      })}
    </div>

    <script type="application/json" is:inline id="attn-labels" set:html={JSON.stringify(attnLabels)}></script>
    <script type="application/json" is:inline id="ffn-labels" set:html={JSON.stringify(ffnLabels)}></script>
    <script type="application/json" is:inline id="layer-subview-map" set:html={JSON.stringify(layerToSubviewKey)}></script>
    <script type="application/json" is:inline id="subview-svgs" set:html={JSON.stringify(subviews)}></script>
    <script type="application/json" is:inline id="evidence-payload" set:html={JSON.stringify(evidencePayload)}></script>

    <div id="layer-detail" class="layer-detail" hidden data-testid="layer-detail">
      <div class="ld-top">
        <strong>Layer <span id="ld-index" class="mono"></span></strong>
        <span class="pill pill-ar" id="ld-attention"></span>
        <span class="pill pill-moe" id="ld-ffn"></span>
      </div>
      <div class="ld-modules muted mono" id="ld-modules"></div>
      <div class="muted mono" id="ld-evidence"></div>
    </div>

    <p class="legend muted">
      <span class="key"><span class="cell" style="background:var(--attention)" /> attention (GQA / MLA / Full)</span>
      <span class="key"><span class="cell" style="background:var(--state)" /> linear / sliding window</span>
      <span class="key"><span class="cell" style="background:var(--compute)" /> MoE</span>
      <span class="key"><span class="cell" style={`background:${isSystemOne ? "var(--decision)" : "var(--line)"}`} /> {isSystemOne ? "dense FFN (System-1)" : "dense FFN"}</span>
    </p>
  </section>

  <!-- Contextual Citation Panel (#38) -->
  <section class="section citation-panel" id="citation-panel" data-testid="citation-panel" aria-live="polite">
    <div class="section-bar">
      <div>
        <h2 data-i18n="detail.citationPanel">Contextual Citation Inspector</h2>
        <p class="muted small-note" id="citation-subtitle" data-i18n="detail.citationDefaultNote">
          Select any diagram node, specification card, or genome layer to inspect exact-model sources vs mechanism references.
        </p>
      </div>
      <button type="button" id="clear-citation" class="btn btn-subtle" hidden>Clear selection</button>
    </div>

    <div id="citation-cards" class="citation-cards">
      {brief && (
        <div class="provenance-overview">
          <div class="prov-group">
            <span class="eyebrow">Exact-Model Primary Sources</span>
            <ul class="prov-list">
              {brief.primary_sources.map((src) => (
                <li>
                  <span class="scope-pill scope-exact">✓ exact model</span>
                  <a href={src.url} rel="noopener noreferrer">{src.kind}</a>
                  <code class="rev-chip">{src.revision.slice(0, 10)}</code>
                  {src.sha256 && <span class="muted mono small-hash">sha256:{src.sha256.slice(0, 12)}</span>}
                </li>
              ))}
            </ul>
          </div>
          {brief.papers.length > 0 && (
            <div class="prov-group">
              <span class="eyebrow">Paper References & Mechanism Scope</span>
              <ul class="prov-list">
                {brief.papers.map((p) => (
                  <li>
                    <span class={`scope-pill ${p.role === "model-specific" ? "scope-exact" : "scope-mech"}`}>
                      {p.role === "model-specific" ? "✓ model-specific" : "◐ mechanism-only"}
                    </span>
                    <a href={p.url} rel="noopener noreferrer">{p.title}</a>
                    <span class="muted"> · {p.locators.join(", ")}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- Full Evidence Ledger in an accessible disclosure (#38) -->
  <section class="section">
    <details id="evidence-ledger" class="ledger-disclosure">
      <summary class="ledger-summary">
        <div>
          <div>
            <strong data-i18n="detail.advancedLedger">Advanced: Full Evidence Ledger</strong>
            <span class="muted mono">({evidence.claims.length} claims)</span>
          </div>
          <p class="muted small-note" data-i18n="detail.evidenceNote">
            Every visible number resolves to an immutable source claim. Expand to filter or audit raw paths.
          </p>
        </div>
      </summary>

      <div class="ledger-body">
        <div class="ev-filters" role="group" aria-label="Filter evidence status">
          <button type="button" class="ev-tab active" data-status="">
            <span data-i18n="detail.evidenceAll">All</span> ({evidence.claims.length})
          </button>
          {Object.entries(statusCounts).map(([st, cnt]) => (
            <button type="button" class="ev-tab" data-status={st}>
              {st} ({cnt})
            </button>
          ))}
        </div>

        <div class="evidence-wrap" data-atlas-scroll="x">
          <table class="evidence">
            <thead>
              <tr>
                <th data-i18n="detail.claim">Claim</th>
                <th data-i18n="detail.value">Value</th>
                <th data-i18n="detail.status">Status</th>
                <th data-i18n="detail.source">Source</th>
              </tr>
            </thead>
            <tbody>
              {evidence.claims.map((c) => (
                <tr data-claim-status={c.status} data-claim-row={c.path}>
                  <td data-label="Claim"><code>{c.path}</code></td>
                  <td data-label="Value" class="mono">{c.status === "unknown" ? "—" : JSON.stringify(c.value)}</td>
                  <td data-label="Status"><span class={`chip chip-${c.status}`} data-i18n={`status.${c.status}`}>{statusSymbol(c.status)} {c.status}</span></td>
                  <td data-label="Source">
                    {c.source?.url ? <a href={c.source.url} rel="noopener noreferrer">{c.source.kind}</a> : c.source?.kind}
                    {c.source?.locator && <span class="muted"> · {c.source.locator}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </details>
  </section>

  <section class="section">
    <h2 data-i18n="detail.compare">Compare</h2>
    <p class="muted" data-i18n="detail.compareNote">Launch a side-by-side comparison with any other model in the atlas.</p>
    <div class="compare-chips">
      {otherOptions.map((o) => (
        <a class="btn" href={o.pairUrl}>vs {o.label}</a>
      ))}
    </div>
  </section>

  <script>
    type SubviewEntry = { title: string; subtitle: string; svg: string };
    type ClaimItem = {
      path: string;
      value: unknown;
      status: string;
      source?: { kind?: string; url?: string; revision?: string; locator?: string };
    };
    type BriefPaper = { url: string; title: string; role: string; locators: string[] };
    type EvidencePayload = {
      model: { id: string; label: string; revision: string };
      ir_version: string;
      paradigm: string;
      claims: ClaimItem[];
      brief: { papers?: BriefPaper[] } | null;
    };

    const attnLabels = JSON.parse(document.getElementById("attn-labels")!.textContent!) as string[];
    const ffnLabels = JSON.parse(document.getElementById("ffn-labels")!.textContent!) as string[];
    const layerSubMap = JSON.parse(document.getElementById("layer-subview-map")!.textContent!) as Record<string, string>;
    const subviewSvgs = JSON.parse(document.getElementById("subview-svgs")!.textContent!) as Record<string, SubviewEntry>;
    const payload = JSON.parse(document.getElementById("evidence-payload")!.textContent!) as EvidencePayload;
    const claimByPath = new Map(payload.claims.map((c) => [c.path, c]));

    // Compare dropdown jump
    const compareSelect = document.getElementById("compare-target") as HTMLSelectElement | null;
    compareSelect?.addEventListener("change", () => {
      if (compareSelect.value) location.href = compareSelect.value;
    });

    // Zoom mode buttons (Fit / 1:1 Pan / 135%) applied symmetrically to active canvas
    const figureWrap = document.getElementById("figure-wrap");
    const subviewCanvas = document.getElementById("subview-canvas");
    const viewButtons = [...document.querySelectorAll<HTMLButtonElement>(".vbtn")];
    function setZoomMode(mode: string) {
      [figureWrap, subviewCanvas].forEach((wrap) => {
        if (!wrap) return;
        wrap.classList.remove("mode-fit", "mode-pan", "mode-zoom");
        wrap.classList.add(`mode-${mode}`);
      });
      viewButtons.forEach((b) => b.classList.toggle("active", b.dataset.viewMode === mode));
    }
    viewButtons.forEach((btn) =>
      btn.addEventListener("click", () => setZoomMode(btn.dataset.viewMode ?? "fit")),
    );

    // State variables synced with URL (?view=...&layer=...&claim=...)
    const overviewStage = document.getElementById("overview-stage")!;
    const subviewStage = document.getElementById("subview-stage")!;
    const subTitle = document.getElementById("subview-title")!;
    const subSubtitle = document.getElementById("subview-subtitle")!;
    const resetOverviewBtn = document.getElementById("reset-overview-btn") as HTMLButtonElement | null;
    const vtabs = [...document.querySelectorAll<HTMLButtonElement>(".vtab")];
    const tabBlockIdx = document.getElementById("tab-block-idx")!;

    const genomeEl = document.querySelector<HTMLElement>(".genome");
    const detail = document.getElementById("layer-detail")!;
    const clearLayerBtn = document.getElementById("clear-layer") as HTMLButtonElement | null;
    const cols = [...document.querySelectorAll<HTMLElement>(".genome .col")];
    const ledgerDetails = document.getElementById("evidence-ledger") as HTMLDetailsElement | null;
    const evidenceRows = [...document.querySelectorAll<HTMLTableRowElement>("table.evidence tbody tr")];

    const citSubtitle = document.getElementById("citation-subtitle")!;
    const citCards = document.getElementById("citation-cards")!;
    const clearCitBtn = document.getElementById("clear-citation") as HTMLButtonElement | null;
    const defaultCitationHtml = citCards.innerHTML;
    const defaultCitSubtitle = citSubtitle.textContent ?? "";

    let currentView = "overview";
    let currentLayer: number | null = null;
    let currentClaims: string[] = [];
    let activeStatusFilter = "";

    function syncUrl(push = false) {
      const params = new URLSearchParams();
      if (currentView !== "overview") params.set("view", currentView);
      if (currentLayer !== null) params.set("layer", String(currentLayer));
      if (currentClaims.length > 0) params.set("claim", currentClaims[0]!);
      const next = params.toString() ? `?${params}` : location.pathname;
      if (push) history.pushState(null, "", next);
      else history.replaceState(null, "", next);
    }

    function esc(s: string): string {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function applyEvidenceFilter() {
      evidenceRows.forEach((row) => {
        const path = row.querySelector("code")?.textContent ?? "";
        const status = row.dataset.claimStatus ?? "";
        const statusOk = !activeStatusFilter || status === activeStatusFilter;
        row.hidden = !statusOk;
        const match = currentClaims.length > 0 && currentClaims.some((p) => path === p || path.startsWith(p));
        row.classList.toggle("dimmed", currentClaims.length > 0 && !match);
        row.classList.toggle("highlighted", match);
      });
    }

    function renderCitations(label: string, paths: string[]) {
      currentClaims = paths.filter((p) => claimByPath.has(p));
      applyEvidenceFilter();

      document.querySelectorAll<HTMLElement>(".hotspot").forEach((hs) => {
        const hsPaths = (hs.dataset.claimPaths ?? "").split(",");
        hs.classList.toggle("active", Boolean(label) && hsPaths.some((p) => currentClaims.includes(p)));
      });

      if (!currentClaims.length) {
        citSubtitle.textContent = defaultCitSubtitle;
        citCards.innerHTML = defaultCitationHtml;
        if (clearCitBtn) clearCitBtn.hidden = true;
        return;
      }

      if (clearCitBtn) clearCitBtn.hidden = false;
      citSubtitle.textContent = `Showing ${currentClaims.length} evidence claim(s) linked to "${label}":`;
      const html = currentClaims
        .map((p) => {
          const c = claimByPath.get(p)!;
          const isExact = c.source?.kind !== "tech_report";
          const val = c.status === "unknown" ? "—" : JSON.stringify(c.value);
          const rev = c.source?.revision ? c.source.revision.slice(0, 10) : payload.model.revision;
          const loc = c.source?.locator ?? "source definition";
          const url = c.source?.url;
          return `
            <article class="cit-card">
              <div class="cit-top">
                <span class="chip chip-${esc(c.status)}">${esc(c.status)}</span>
                <span class="scope-pill ${isExact ? "scope-exact" : "scope-mech"}">${isExact ? "✓ exact model" : "◐ mechanism-only"}</span>
                <code class="rev-chip">${esc(rev)}</code>
              </div>
              <div class="cit-val mono">${esc(val)}</div>
              <div class="cit-loc">
                ${url ? `<a href="${esc(url)}" rel="noopener noreferrer">${esc(c.source?.kind ?? "source")}</a>` : `<span>${esc(c.source?.kind ?? "source")}</span>`}
                <span class="muted"> · ${esc(loc)}</span>
              </div>
              <div class="cit-foot">
                <code class="cit-path">${esc(c.path)}</code>
                <button type="button" class="btn-mini ledger-jump" data-jump-path="${esc(c.path)}">Ledger ↗</button>
              </div>
            </article>
          `;
        })
        .join("");
      citCards.innerHTML = `<div class="cit-grid">${html}</div>`;
      citCards.querySelectorAll<HTMLButtonElement>(".ledger-jump").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (ledgerDetails) ledgerDetails.open = true;
          const targetRow = evidenceRows.find((r) => r.dataset.claimRow === btn.dataset.jumpPath);
          targetRow?.scrollIntoView({ block: "center", behavior: "smooth" });
        });
      });
    }

    function attachSvgInteractivity(container: HTMLElement) {
      container.querySelectorAll<SVGGElement>(".node[data-claim-path], .node[data-node-id], .group[data-claim-path]").forEach((el) => {
        const cp = el.dataset.claimPath;
        if (!cp) return;
        el.setAttribute("tabindex", "0");
        el.setAttribute("role", "button");
        el.style.cursor = "pointer";
        const label = el.querySelector("text")?.textContent ?? cp;
        const trigger = () => {
          renderCitations(label, [cp]);
          syncUrl(false);
        };
        el.addEventListener("click", trigger);
        el.addEventListener("keydown", (ev) => {
          if (ev.key === "Enter" || ev.key === " ") {
            ev.preventDefault();
            trigger();
          }
        });
      });
    }

    function activateSubview(view: string, layerIdx: number | null, push = true) {
      currentView = view;
      vtabs.forEach((t) => {
        const active = t.dataset.subview === view;
        t.classList.toggle("active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });
      if (resetOverviewBtn) resetOverviewBtn.hidden = view === "overview";

      if (view === "overview") {
        overviewStage.hidden = false;
        subviewStage.hidden = true;
        if (push) syncUrl(true);
        return;
      }

      let subKey = `module:${view}`;
      if (view === "block") {
        const idx = layerIdx ?? currentLayer ?? 0;
        currentLayer = idx;
        tabBlockIdx.textContent = `L${idx}`;
        subKey = layerSubMap[String(idx)] ?? layerSubMap["0"]!;
      }

      const sub = subviewSvgs[subKey];
      if (!sub) {
        activateSubview("overview", currentLayer, push);
        return;
      }
      overviewStage.hidden = true;
      subviewStage.hidden = false;
      subTitle.textContent = view === "block" && currentLayer !== null ? `Layer ${currentLayer} Block` : sub.title;
      subSubtitle.textContent = sub.subtitle;
      subviewCanvas!.innerHTML = sub.svg;
      attachSvgInteractivity(subviewCanvas!);
      if (push) syncUrl(true);
    }

    function selectLayer(i: number, opts: { scroll?: boolean; switchView?: boolean; push?: boolean } = {}) {
      const col = cols[i];
      if (!col) return;
      const layerNum = Number(col.dataset.layer!);
      currentLayer = layerNum;
      cols.forEach((c) => c.setAttribute("aria-selected", "false"));
      col.setAttribute("aria-selected", "true");
      tabBlockIdx.textContent = `L${layerNum}`;

      const attn = col.dataset.attention!;
      const ffn = col.dataset.ffn!;
      const aMod = col.dataset.attnModule ?? "";
      const fMod = col.dataset.ffnModule ?? "";
      document.getElementById("ld-index")!.textContent = String(layerNum);
      document.getElementById("ld-attention")!.textContent = attn;
      document.getElementById("ld-ffn")!.textContent = ffn;
      document.getElementById("ld-modules")!.textContent = `attention: ${aMod} · ffn: ${fMod}`;

      const matchedPaths = [
        `topology.attention_groups[${attnLabels.indexOf(attn)}]`,
        `topology.ffn_groups[${ffnLabels.indexOf(ffn)}]`,
      ].filter((p) => !p.includes("-1"));
      document.getElementById("ld-evidence")!.textContent = matchedPaths.length
        ? `linked claims: ${matchedPaths.join(", ")}`
        : "";
      detail.hidden = false;
      if (clearLayerBtn) clearLayerBtn.hidden = false;

      renderCitations(`Layer ${layerNum} (${attn} + ${ffn})`, matchedPaths);
      if (opts.switchView !== false) {
        activateSubview("block", layerNum, opts.push ?? true);
      } else if (opts.push) {
        syncUrl(true);
      } else {
        syncUrl(false);
      }
      if (opts.scroll) {
        subviewStage.scrollIntoView({ block: "nearest", behavior: "auto" });
      }
    }

    function clearLayer(returnOverview = true) {
      cols.forEach((c) => c.setAttribute("aria-selected", "false"));
      currentLayer = null;
      detail.hidden = true;
      if (clearLayerBtn) clearLayerBtn.hidden = true;
      renderCitations("", []);
      if (returnOverview) activateSubview("overview", null, true);
      else syncUrl(false);
    }

    // Bind UI triggers
    vtabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const sub = tab.dataset.subview ?? "overview";
        if (sub === "block" && currentLayer === null) selectLayer(0, { switchView: true, push: true });
        else activateSubview(sub, currentLayer, true);
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".m-sub-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.jumpSubview ?? "attention";
        if (target === "block") selectLayer(currentLayer ?? 0, { switchView: true, push: true });
        else activateSubview(target, currentLayer, true);
        subviewStage.scrollIntoView({ block: "start", behavior: "auto" });
      });
    });

    resetOverviewBtn?.addEventListener("click", () => activateSubview("overview", currentLayer, true));
    clearLayerBtn?.addEventListener("click", () => clearLayer(true));
    clearCitBtn?.addEventListener("click", () => {
      renderCitations("", []);
      syncUrl(false);
    });

    document.querySelectorAll<HTMLButtonElement>(".hotspot, .fact-btn").forEach((el) => {
      el.addEventListener("click", () => {
        const paths = (el.dataset.claimPaths ?? "").split(",").filter(Boolean);
        renderCitations(el.dataset.label ?? "Selection", paths);
        syncUrl(false);
      });
    });

    cols.forEach((col, i) => col.addEventListener("click", () => selectLayer(i, { switchView: true, push: true })));
    genomeEl?.addEventListener("keydown", (ev) => {
      const cur = cols.findIndex((c) => c.getAttribute("aria-selected") === "true");
      if (ev.key === "ArrowRight") { selectLayer(Math.min(cur + 1, cols.length - 1)); ev.preventDefault(); }
      if (ev.key === "ArrowLeft") { selectLayer(Math.max(cur - 1, 0)); ev.preventDefault(); }
      if (ev.key === "Home") { selectLayer(0); ev.preventDefault(); }
      if (ev.key === "End") { selectLayer(cols.length - 1); ev.preventDefault(); }
      if (ev.key === "Escape") { clearLayer(true); ev.preventDefault(); }
    });

    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && currentView !== "overview") {
        activateSubview("overview", currentLayer, true);
      }
    });

    // Evidence ledger status filter tabs
    const evTabs = [...document.querySelectorAll<HTMLButtonElement>(".ev-tab")];
    evTabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        activeStatusFilter = tab.dataset.status ?? "";
        evTabs.forEach((t) => t.classList.toggle("active", t === tab));
        applyEvidenceFilter();
      }),
    );

    // URL restore on initial load & browser back/forward (popstate)
    function restoreFromUrl() {
      const params = new URLSearchParams(location.search);
      const qView = params.get("view") ?? "overview";
      const qLayer = params.get("layer");
      const qClaim = params.get("claim");

      if (qLayer !== null && Number.isInteger(Number(qLayer)) && Number(qLayer) >= 0 && Number(qLayer) < cols.length) {
        selectLayer(Number(qLayer), { switchView: qView === "block", push: false });
      } else {
        currentLayer = null;
        detail.hidden = true;
        cols.forEach((c) => c.setAttribute("aria-selected", "false"));
      }

      if (qView !== "block" || currentLayer === null) {
        activateSubview(qView, currentLayer, false);
      }

      if (qClaim && claimByPath.has(qClaim)) {
        renderCitations(qClaim, [qClaim]);
      } else if (qLayer === null) {
        renderCitations("", []);
      }
    }

    restoreFromUrl();
    window.addEventListener("popstate", restoreFromUrl);

    // Canonical PNG, SVG, and Evidence Manifest exporters (decoupled from view zoom/focus state)
    document.querySelectorAll<HTMLButtonElement>(".png-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement("canvas");
          canvas.width = (img.naturalWidth || 1360) * 2;
          canvas.height = (img.naturalHeight || 860) * 2;
          const ctx = canvas.getContext("2d")!;
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob((blob) => {
            const a = document.createElement("a");
            a.href = URL.createObjectURL(blob!);
            a.download = `${btn.dataset.name}.png`;
            a.click();
            URL.revokeObjectURL(a.href);
          }, "image/png");
        };
        img.src = btn.dataset.fig!;
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".copy-svg-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = await fetch(btn.dataset.fig!).then((r) => r.text());
        await navigator.clipboard?.writeText(text);
        const orig = btn.textContent;
        btn.textContent = "✓ Copied";
        setTimeout(() => { btn.textContent = orig; }, 1400);
      });
    });

    document.getElementById("export-manifest-btn")?.addEventListener("click", (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const blob = new Blob([JSON.stringify(payload, null, 2) + "\n"], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `${btn.dataset.name}-evidence-manifest.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
  </script>

