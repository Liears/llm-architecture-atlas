        font-size: 0.76rem;
        text-transform: uppercase;
        color: var(--muted);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :global(html),
      :global(*),
      :global(*::before),
      :global(*::after) {
        scroll-behavior: auto !important;
        transition: none !important;
        animation: none !important;
      }
    }
  </style>
</Base>
