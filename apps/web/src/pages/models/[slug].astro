      .detail-head {
        gap: 0.35rem;
        padding-bottom: 0.55rem;
        margin-bottom: 0.65rem;
      }
      .detail-head h1 {
        font-size: 1.38rem;
        margin-bottom: 0.15rem;
      }
      .arch-summary {
        font-size: 0.84rem;
