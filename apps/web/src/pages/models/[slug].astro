---
import Base from "../../layouts/Base.astro";
import { loadModels } from "../../lib/atlas.js";
import { buildCatalog, buildGenome, genomeCellRole, formatParams, formatContext } from "@atlas/catalog";
import {
  buildScheduleRuns,
  compileForModel,
  compileLayerBlockSubview,
  compileModuleSubview,
  positionForModel,
  type CompiledSubview,
} from "@atlas/diagram-engine";
import { renderSvg } from "@atlas/renderer-svg";

export function getStaticPaths() {
  const all = loadModels();
  return all.map((m, idx) => ({ params: { slug: m.slug }, props: { model: m, index: idx, allModels: all } }));
}

const { model, index, allModels } = Astro.props;
const { arch, evidence, brief } = model;
const facts = arch.facts;
const genome = buildGenome(arch);
const [entry] = buildCatalog([arch]);
const isSystemOne = entry!.paradigm === "system_one_decision";
const dh = arch.topology.decision_head;

const roleColor: Record<string, string> = {
  attention: "var(--attention)",
  state: "var(--state)",
  compute: "var(--compute)",
  muted: "var(--line)",
};

const attnGroups = arch.topology.attention_groups;
const ffnGroups = arch.topology.ffn_groups;
const attnLabels = attnGroups.map((g) => g.label);
const ffnLabels = ffnGroups.map((g) => g.label);

const statusSymbol = (s: string) =>
  s === "verified" ? "✓" : s === "reported" ? "•" : s === "derived" ? "=" : s === "inferred" ? "?" : s === "conflict" ? "!" : "?";

const otherOptions = allModels
  .map((m, i) => ({
    slug: m.slug,
    label: m.arch.model.label,
    pairUrl:
      i < index
        ? `/llm-architecture-atlas/compare/${m.slug}--vs--${model.slug}/`
        : `/llm-architecture-atlas/compare/${model.slug}--vs--${m.slug}/`,
  }))
  .filter((o) => o.slug !== model.slug);

const statusCounts = evidence.claims.reduce<Record<string, number>>((acc, c) => {
  acc[c.status] = (acc[c.status] ?? 0) + 1;
  return acc;
}, {});

const scheduleRuns = buildScheduleRuns(facts.num_hidden_layers, attnGroups, ffnGroups);

const spineSummary = isSystemOne
  ? dh?.readout_mode === "mask_marker_mlp"
    ? ["State + Typed Q", "Token + Type Emb", `${facts.num_hidden_layers}L Encoder`, `${dh.head_layers ?? 2}L Decision Head`, "Calibrated Scorer", "Typed JSON"]
    : ["State + Image + Q", "Embed + Vision", `${facts.num_hidden_layers}L Hybrid`, "1-Step Prefill", "Letter Logits + T", "Typed JSON"]
  : ["Token ids", "Token embedding", `${facts.num_hidden_layers}L Decoder`, "Final RMSNorm", "LM head"];
const spineSummaryZh = isSystemOne
  ? dh?.readout_mode === "mask_marker_mlp"
    ? ["状态 + 问题", "词嵌入 + 类型编码", `${facts.num_hidden_layers}L 编码器`, `${dh.head_layers ?? 2}L 决策头`, "校准评分器", "强类型 JSON"]
    : ["状态 + 图像 + 问题", "词嵌入 + 视觉塔", `${facts.num_hidden_layers}L 混合骨干`, "单步预填充", "字母 Logits + T", "强类型 JSON"]
  : ["输入 Token ID", "词嵌入层", `${facts.num_hidden_layers}L 解码器`, "最终 RMSNorm", "词表输出头"];

const attnSummaryStr = attnGroups.map((g) => `${g.layers.length} ${g.label}`).join(" + ");
const ffnSummaryStr = ffnGroups.map((g) => `${g.layers.length} ${g.label}`).join(" → ");
const archSummaryLine = isSystemOne
  ? `${facts.num_hidden_layers}-layer non-autoregressive System-1 encoder (${attnSummaryStr}; readout: ${dh?.readout_mode ?? "decision head"}) · ${formatParams(facts.total_params)} params.`
  : `${facts.num_hidden_layers}-layer autoregressive decoder (${attnSummaryStr}; ${ffnSummaryStr}${arch.topology.residual?.scheme === "mhc" ? `; ${arch.topology.residual.streams}-stream mHC` : ""}) · ${formatParams(facts.total_params)}${facts.active_params && facts.active_params !== facts.total_params ? ` / ${formatParams(facts.active_params)} active` : ""}.`;
const archSummaryLineZh = isSystemOne
  ? `${facts.num_hidden_layers} 层非自回归 System-1 编码器（${attnSummaryStr}；读出模式：${dh?.readout_mode ?? "决策头"}）· 总参数 ${formatParams(facts.total_params)}。`
  : `${facts.num_hidden_layers} 层自回归解码器（${attnSummaryStr}；${ffnSummaryStr}${arch.topology.residual?.scheme === "mhc" ? `；${arch.topology.residual.streams} 流 mHC` : ""}）· 总参数 ${formatParams(facts.total_params)}${facts.active_params && facts.active_params !== facts.total_params ? ` / 激活 ${formatParams(facts.active_params)}` : ""}。`;

// Build-time overview hotspot boxes + real compiled per-layer & module subviews (#36, #37)
const overviewScene = compileForModel(arch, evidence);
const { positioned: overviewPos } = positionForModel(overviewScene);

interface OverviewHotspot {
  id: string;
  kind: "node" | "edge";
  label: string;
  detail?: string;
  claimPaths: string[];
  xPct: number;
  yPct: number;
  wPct: number;
  hPct: number;
}

const clampPct = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));
function polylineMidpoint(pts: Array<{ x: number; y: number }>): { x: number; y: number } {
  if (pts.length === 1) return pts[0]!;
  let total = 0;
  for (let i = 1; i < pts.length; i++) {
    total += Math.hypot(pts[i]!.x - pts[i - 1]!.x, pts[i]!.y - pts[i - 1]!.y);
  }
  if (total === 0) return pts[0]!;
  let target = total / 2;
  for (let i = 1; i < pts.length; i++) {
    const a = pts[i - 1]!;
    const b = pts[i]!;
    const seg = Math.hypot(b.x - a.x, b.y - a.y);
    if (target <= seg) {
      const t = seg === 0 ? 0 : target / seg;
      return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t };
    }
    target -= seg;
  }
  return pts[pts.length - 1]!;
}

const overviewNodeById = new Map(overviewScene.nodes.map((n) => [n.id, n]));
const overviewEdgeById = new Map(overviewScene.edges.map((e) => [e.id, e]));

const overviewNodeHotspots: OverviewHotspot[] = overviewPos.nodes
  .map((box): OverviewHotspot | null => {
    const sem = overviewNodeById.get(box.id);
    if (!sem) return null;
    const paths = new Set<string>();
    if (sem.claimPath) paths.add(sem.claimPath);
    for (const c of sem.claims ?? []) paths.add(c.claimPath);
    if (paths.size === 0) return null;
    return {
      id: sem.id,
      kind: "node",
      label: sem.label,
      ...(sem.detail ? { detail: sem.detail } : {}),
      claimPaths: [...paths],
      xPct: Number(((box.x / overviewPos.size.w) * 100).toFixed(3)),
      yPct: Number(((box.y / overviewPos.size.h) * 100).toFixed(3)),
      wPct: Number(((box.w / overviewPos.size.w) * 100).toFixed(3)),
      hPct: Number(((box.h / overviewPos.size.h) * 100).toFixed(3)),
    };
  })
  .filter((x): x is OverviewHotspot => x !== null);

const overviewEdgeHotspots: OverviewHotspot[] = overviewPos.edges
  .map((edge): OverviewHotspot | null => {
    if (!edge.claimPath || edge.points.length < 2) return null;
    const sem = overviewEdgeById.get(edge.id);
    const fromLabel = sem ? (overviewNodeById.get(sem.from)?.label ?? sem.from) : "";
    const toLabel = sem ? (overviewNodeById.get(sem.to)?.label ?? sem.to) : "";
    const label =
      edge.label && fromLabel && toLabel
        ? `${fromLabel} → ${toLabel} (${edge.label})`
        : fromLabel && toLabel
          ? `${fromLabel} → ${toLabel}`
          : (edge.label ?? edge.id);
    const mid = polylineMidpoint(edge.points);
    return {
      id: edge.id,
      kind: "edge",
      label,
      claimPaths: [edge.claimPath],
      xPct: Number(clampPct((mid.x / overviewPos.size.w) * 100, 2, 98).toFixed(3)),
      yPct: Number(clampPct((mid.y / overviewPos.size.h) * 100, 3, 97).toFixed(3)),
      wPct: 2.4,
      hPct: 3.4,
    };
  })
  .filter((x): x is OverviewHotspot => x !== null);

const overviewHotspots: OverviewHotspot[] = [...overviewEdgeHotspots, ...overviewNodeHotspots];

const subviews: Record<string, { title: string; subtitle: string; svg: string }> = {};
const layerToSubviewKey: Record<string, string> = {};

const renderSub = (sub: CompiledSubview) => {
  subviews[sub.key] = {
    title: sub.title,
    subtitle: sub.subtitle,
    svg: renderSvg(sub.positioned, { title: `${arch.model.label} — ${sub.title}`, showTitle: true }),
  };
};

// Module subviews
for (const modKind of ["attention", "ffn", "residual"] as const) {
  renderSub(compileModuleSubview(arch, evidence, modKind));
}
if (isSystemOne && dh) {
  renderSub(compileModuleSubview(arch, evidence, "decision"));
}

// Per-layer block subviews compiled once per distinct (attention, ffn, tail) class
for (let i = 0; i < facts.num_hidden_layers; i++) {
  const blockSub = compileLayerBlockSubview(arch, evidence, i);
  layerToSubviewKey[String(i)] = blockSub.key;
  if (!subviews[blockSub.key]) {
    renderSub(blockSub);
  }
}

const evidencePayload = {
  model: arch.model,
  ir_version: arch.ir_version,
  paradigm: entry!.paradigm,
  facts,
  topology: arch.topology,
  claims: evidence.claims,
  brief: brief ?? null,
};
---

<Base title={`${arch.model.label} — LLM Architecture Atlas`} active="detail">
  <div class="crumb-row">
    <a class="crumb-back" href="/llm-architecture-atlas/" data-i18n="detail.backCatalog">← Catalog</a>
    <div class="crumb-meta">
      <span class={`pill ${isSystemOne ? "pill-s1" : "pill-ar"}`} data-i18n={isSystemOne ? "detail.pillS1" : "detail.pillAr"}>
        {isSystemOne ? "System-1 · Non-Autoregressive" : "System-2 · Autoregressive"}
      </span>
      <span class="pill">{arch.model.family ?? "Other"}</span>
      {arch.model.license && <span class="pill pill-license mono">{arch.model.license}</span>}
    </div>
  </div>

  <header class="detail-head">
    <div class="head-copy">
      <h1>{arch.model.label}</h1>
      <p class="arch-summary" data-i18n-en={archSummaryLine} data-i18n-zh={archSummaryLineZh}>{archSummaryLine}</p>
      <p class="muted meta-line">
        <span data-i18n="detail.generatedFrom">Architecture IR</span> {arch.ir_version} ·
        <span data-i18n="detail.revision">Revision</span> <code class="rev-chip">{arch.model.revision}</code> ·
        <a href="https://github.com/Liears/llm-architecture-atlas/issues" data-i18n="detail.reportCorrection">Report correction</a>
      </p>
    </div>

    <div class="compare-picker">
      <select id="compare-target" aria-label="Compare with another model">
        <option value="" data-i18n="detail.compareWith">Compare with…</option>
        {otherOptions.map((o) => <option value={o.pairUrl}>{o.label}</option>)}
      </select>
    </div>
  </header>

  <section class="section stage-section" aria-label="Architecture diagram explorer">
    <div class="section-bar">
      <div class="stage-heading">
        <h2 data-i18n="detail.overview">Architecture Plate</h2>
        <div class="view-tabs" role="tablist" aria-label="Architecture subviews">
          <button type="button" role="tab" aria-selected="true" class="vtab active" data-subview="overview" data-i18n="detail.viewOverview">Overview</button>
          <button type="button" role="tab" aria-selected="false" class="vtab" data-subview="attention" data-i18n="detail.viewAttn">Attention</button>
          <button type="button" role="tab" aria-selected="false" class="vtab" data-subview="ffn" data-i18n="detail.viewFfn">MoE / FFN</button>
          <button type="button" role="tab" aria-selected="false" class="vtab" data-subview="residual" data-i18n="detail.viewResidual">Residual</button>
          {isSystemOne && dh && (
            <button type="button" role="tab" aria-selected="false" class="vtab" data-subview="decision" data-i18n="detail.viewDecision">Decision</button>
          )}
          <button type="button" role="tab" aria-selected="false" class="vtab" id="tab-block" data-subview="block">
            <span data-i18n="detail.viewBlock">Layer Block</span> <span id="tab-block-idx" class="mono">L0</span>
          </button>
        </div>
      </div>

      <div class="canvas-controls" role="toolbar" aria-label="Diagram zoom and flow replay controls">
        <button type="button" id="reset-overview-btn" class="btn btn-subtle" hidden data-i18n="detail.resetOverview">Back to Overview</button>
        <div class="view-modes flow-modes" role="group" data-i18n-aria="flow.toolbarLabel" aria-label="Token execution flow replay">
          <button type="button" id="flow-toggle" class="vbtn flow-play-btn" data-i18n="flow.play">▶ Flow</button>
          <button type="button" id="flow-prev" class="vbtn" title="Previous step" aria-label="Previous flow step">‹</button>
          <button type="button" id="flow-next" class="vbtn" title="Next step" aria-label="Next flow step">›</button>
        </div>
        <div class="view-modes" role="group" aria-label="Zoom mode">
          <button type="button" class="vbtn active" data-view-mode="fit" data-i18n="detail.fitView">Fit</button>
          <button type="button" class="vbtn" data-view-mode="pan" data-i18n="detail.scrollView">1:1 Pan</button>
          <button type="button" class="vbtn" data-view-mode="zoom" data-i18n="detail.zoomView">135%</button>
        </div>
      </div>
    </div>

    <div id="flow-hud" class="flow-hud" hidden aria-live="polite">
      <span id="flow-step-badge" class="flow-badge mono">1/6</span>
      <span id="flow-caption" class="flow-caption"></span>
      <button type="button" id="flow-stop" class="btn btn-subtle flow-close-btn" data-i18n="flow.stop">Close</button>
    </div>

    <div class="stage-body">
      <div id="overview-stage">
        <div id="figure-wrap" class="figure-wrap mode-fit" data-atlas-scroll="x" tabindex="0" aria-label="Scrollable interactive architecture figure">
          <div class="figure-inner">
            <img
              class="diagram-img"
              src={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`}
              data-en-src={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`}
              alt={`Architecture overview of ${arch.model.label}, generated from the Architecture IR`}
            />
            <div class="hotspot-layer" aria-label="Interactive diagram node and edge claims">
              {overviewHotspots.map((hs) => (
                <button
                  type="button"
                  class={`hotspot${hs.kind === "edge" ? " hotspot-edge" : ""}`}
                  style={`left:${hs.xPct}%;top:${hs.yPct}%;width:${hs.wPct}%;height:${hs.hPct}%`}
                  data-node-id={hs.kind === "node" ? hs.id : undefined}
                  data-edge-id={hs.kind === "edge" ? hs.id : undefined}
                  data-claim-paths={hs.claimPaths.join(",")}
                  data-label={hs.label}
                  data-detail={hs.detail ?? ""}
                  aria-label={`${hs.label}${hs.detail ? `: ${hs.detail}` : ""} — inspect citation`}
                  title={`${hs.label}${hs.detail ? ` (${hs.detail})` : ""}`}
                />
              ))}
            </div>
          </div>
        </div>
      </div>

      <div id="subview-stage" class="subview-stage" hidden data-testid="subview-stage">
        <div class="subview-banner">
          <div>
            <strong id="subview-title"></strong>
            <span id="subview-subtitle" class="muted mono"></span>
          </div>
          <span class="muted small-hint" data-i18n="detail.subviewHint">Click any node for source citation · Esc returns to overview</span>
        </div>
        <div id="subview-canvas" class="figure-wrap mode-fit" data-atlas-scroll="x" tabindex="0"></div>
      </div>

      <!-- Mobile first-screen structured reading overview (#36): avoids tiny 105px desktop thumbnail -->
      <section class="mobile-cards" aria-label="Structured reading breakdown">
        <div class="section-bar">
          <div>
            <h3 data-i18n="detail.mobileBreakdown">Mobile Structured Overview</h3>
            <p class="muted small-note" data-i18n="detail.mobileBreakdownNote">
              Readable execution spine, repeating layer schedule, and interactive subsystem entry points.
            </p>
          </div>
        </div>
        <div class="reading-cards-grid">
          <article class="reading-card">
            <span class="eyebrow" data-i18n="detail.mobileSpine">Main Execution Spine</span>
            <p class="spine-chain" data-i18n-en={spineSummary.join(" → ")} data-i18n-zh={spineSummaryZh.join(" → ")}>{spineSummary.join(" → ")}</p>
          </article>
          <article class="reading-card">
            <span class="eyebrow" data-i18n="detail.mobileSchedule" data-n={String(facts.num_hidden_layers)}>Layer Schedule · {facts.num_hidden_layers}L</span>
            <ul class="schedule-pills">
              {scheduleRuns.map((r) => (
                <li><strong>{r.label}</strong>: <span class="mono">{r.detail}</span></li>
              ))}
            </ul>
            <div class="mobile-subview-triggers">
              <button type="button" class="btn m-sub-btn" data-jump-subview="attention" data-i18n="detail.mobileBtnAttn">Attention diagram →</button>
              <button type="button" class="btn m-sub-btn" data-jump-subview="ffn" data-i18n="detail.mobileBtnFfn">MoE / FFN diagram →</button>
              <button type="button" class="btn m-sub-btn" data-jump-subview="block" data-i18n="detail.mobileBtnBlock">Inspect L0 block →</button>
            </div>
          </article>
          {isSystemOne && dh && (
            <article class="reading-card reading-card-s1">
              <span class="eyebrow" data-i18n="detail.mobileS1">System-1 Readout & Calibration</span>
              <p class="mini-note">{dh.note}</p>
            </article>
          )}
        </div>
      </section>

      <div class="stage-footer" role="toolbar" aria-label="Diagram export controls">
        <span class="muted small-note" data-i18n="detail.stageHint">Click any block or wire to inspect pinned source evidence.</span>
        <div class="export-btns">
          <a class="btn" href={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`} download data-i18n="detail.downloadSvg">Download SVG</a>
          <button type="button" class="btn png-btn" data-fig={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`} data-name={model.slug} data-i18n="detail.downloadPng">Download PNG</button>
          <button type="button" class="btn copy-svg-btn" data-fig={`/llm-architecture-atlas/figures/${model.slug}-generated.svg`} data-i18n="detail.copySvg">Copy SVG</button>
          <button type="button" id="export-manifest-btn" class="btn" data-name={model.slug} data-i18n="detail.exportManifest">Manifest</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 data-i18n="detail.factSheet">Technical Specification</h2>
    <dl class="facts">
      <button type="button" class="fact-btn" data-claim-paths="facts.num_hidden_layers" data-label="Layers"><dt data-i18n="fact.layers">Layers</dt><dd class="mono">{facts.num_hidden_layers}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.hidden_size" data-label="Hidden dim"><dt data-i18n="fact.hiddenSize">Hidden dim</dt><dd class="mono">{facts.hidden_size.toLocaleString("en-US")}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.num_attention_heads,facts.num_key_value_heads,facts.head_dim" data-label="Attn / KV heads"><dt data-i18n="fact.heads">Attn / KV heads</dt><dd class="mono">{facts.num_attention_heads}{facts.num_key_value_heads ? ` · KV ${facts.num_key_value_heads}` : ""}{facts.head_dim ? ` · d=${facts.head_dim}` : ""}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.vocab_size" data-label="Vocab size"><dt data-i18n="fact.vocab">Vocab size</dt><dd class="mono">{facts.vocab_size?.toLocaleString("en-US") ?? "—"}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.context_tokens" data-label="Context"><dt data-i18n="fact.context">Context</dt><dd class="mono">{formatContext(facts.context_tokens)}</dd></button>
      <button type="button" class="fact-btn" data-claim-paths="facts.total_params,facts.active_params" data-label="Parameters">
        <dt data-i18n="fact.params">Parameters</dt>
        <dd class="mono">
          {facts.total_params ? (
            <>{formatParams(facts.total_params)}<span data-i18n-en=" total" data-i18n-zh=" 总计"> total</span></>
          ) : "—"}
          {facts.active_params && facts.active_params !== facts.total_params && (
            <> / {formatParams(facts.active_params)}<span data-i18n-en=" active" data-i18n-zh=" 激活"> active</span></>
          )}
        </dd>
      </button>
    </dl>
  </section>

  <section class="section kv-section" id="kv-estimator">
    <div class="section-bar kv-header">
      <div>
        <h2 data-i18n="kv.title">KV Cache & Memory Estimator</h2>
        <p class="muted small-note" data-i18n="kv.subtitle">Derived deterministically from pinned weights, layer count, and attention/KV dimensions in Architecture IR.</p>
      </div>
      <div class="kv-controls">
        <div class="kv-group">
          <span class="kv-lbl" data-i18n="kv.ctx">Context length</span>
          <div class="view-modes" role="group" aria-label="Context length presets">
            <button type="button" class="vbtn kv-ctx-btn" data-ctx="4096">4K</button>
            <button type="button" class="vbtn kv-ctx-btn active" data-ctx="32768">32K</button>
            <button type="button" class="vbtn kv-ctx-btn" data-ctx="131072">128K</button>
            <button type="button" class="vbtn kv-ctx-btn" data-ctx="1048576">1M</button>
          </div>
        </div>
        <div class="kv-group">
          <span class="kv-lbl" data-i18n="kv.prec">Weight precision</span>
          <div class="view-modes" role="group" aria-label="Weight precision presets">
            <button type="button" class="vbtn kv-prec-btn active" data-bytes="2" data-prec="BF16">BF16</button>
            <button type="button" class="vbtn kv-prec-btn" data-bytes="1" data-prec="FP8">FP8</button>
            <button type="button" class="vbtn kv-prec-btn" data-bytes="0.5" data-prec="INT4">INT4</button>
          </div>
        </div>
      </div>
    </div>
    <div class="kv-grid">
      <div class="kv-card">
        <span class="kv-card-k" data-i18n="kv.weights">Model Weights</span>
        <strong class="kv-card-v mono" id="kv-weights">—</strong>
        <span class="kv-card-s muted mono" id="kv-weights-note"></span>
      </div>
      <div class="kv-card">
        <span class="kv-card-k" data-i18n="kv.perTok">KV Cache / Token (BF16)</span>
        <strong class="kv-card-v mono" id="kv-pertok">—</strong>
        <span class="kv-card-s muted" id="kv-pertok-note"></span>
      </div>
      <div class="kv-card">
        <span class="kv-card-k" data-i18n="kv.cacheTotal">KV Cache @ Context</span>
        <strong class="kv-card-v mono" id="kv-total-cache">—</strong>
        <span class="kv-card-s muted mono" id="kv-cache-note"></span>
      </div>
      <div class="kv-card">
        <span class="kv-card-k" data-i18n="kv.totalFootprint">Weights + KV Total</span>
        <strong class="kv-card-v mono" id="kv-total-vram">—</strong>
        <span class="kv-card-s muted" id="kv-fit-note"></span>
      </div>
    </div>
  </section>

  {isSystemOne && dh && (
    <section class="section decision-panel">
      <h2 data-i18n="detail.decisionSpec">System-1 Decision Contract</h2>
      <dl class="facts">
        <button type="button" class="fact-btn" data-claim-paths="topology.decision_head.readout_mode" data-label="Readout mode">
          <dt data-i18n="detail.readoutMode">Readout mode</dt>
          <dd class="mono">{dh.readout_mode}</dd>
        </button>
        <button type="button" class="fact-btn" data-claim-paths="topology.decision_head.primitives" data-label="Typed primitives">
          <dt data-i18n="detail.primitives">Typed primitives</dt>
          <dd class="mono">{dh.primitives?.join(", ") || "—"}</dd>
        </button>
        <button type="button" class="fact-btn" data-claim-paths="topology.decision_head.calibration" data-label="Calibration">
          <dt data-i18n="detail.calibration">Calibration</dt>
          <dd class="mono">{dh.calibration ?? "—"}</dd>
        </button>
        <button type="button" class="fact-btn" data-claim-paths="topology.decision_head.action_head,topology.decision_head.max_options,topology.decision_head.prefix_cache,topology.decision_head.vision_encoder" data-label="Execution features">
          <dt data-i18n="detail.extras">Execution features</dt>
          <dd class="mono">
            {[
              dh.head_layers ? `${dh.head_layers}L head` : null,
              dh.action_head ? dh.action_head : null,
              dh.max_options ? `≤${dh.max_options} opts/pass` : null,
              dh.prefix_cache ? "Prefix KV cache" : null,
              dh.vision_encoder ? dh.vision_encoder : null,
            ]
              .filter(Boolean)
              .join(" · ") || "Single forward pass"}
          </dd>
        </button>
      </dl>
      {dh.note && <p class="muted decision-note">{dh.note}</p>}
    </section>
  )}

  <section class="section">
    <div class="section-bar">
      <div>
        <h2 data-i18n="detail.genome">Layer Genome & Drill-Down</h2>
        <p class="muted small-note" data-i18n="detail.genomeNote">
          Click or use ← / → keys on any layer column to load its module block diagram and linked citations.
        </p>
      </div>
      <button type="button" id="clear-layer" class="btn" hidden data-i18n="detail.clearLayer">Clear layer</button>
    </div>

    <div class="genome" data-atlas-scroll="x" role="listbox" aria-label={`Per-layer genome: ${genome.numLayers} layers. Arrow keys move, Enter selects.`} tabindex="0">
      {genome.layers.map((l) => {
        const aMod = attnGroups.find((g) => g.label === l.attention)?.module ?? l.attentionKind;
        const fMod = ffnGroups.find((g) => g.label === l.ffn)?.module ?? l.ffnKind;
        return (
          <button
            type="button"
            class="col"
            role="option"
            aria-selected="false"
            data-layer={String(l.index)}
            data-attention={l.attention}
            data-attn-kind={l.attentionKind}
            data-attn-module={aMod}
            data-ffn={l.ffn}
            data-ffn-kind={l.ffnKind}
            data-ffn-module={fMod}
            title={`layer ${l.index}: attention ${l.attention} · ffn ${l.ffn}`}
          >
            <span class="cell" style={`background:${roleColor[genomeCellRole(l)]}`} />
            <span class="cell ffn" style={`background:${l.ffnKind === "moe" ? "var(--compute)" : isSystemOne ? "var(--decision)" : "var(--line)"}`} />
          </button>
        );
      })}
    </div>

    <script type="application/json" is:inline id="attn-labels" set:html={JSON.stringify(attnLabels)}></script>
    <script type="application/json" is:inline id="ffn-labels" set:html={JSON.stringify(ffnLabels)}></script>
    <script type="application/json" is:inline id="layer-subview-map" set:html={JSON.stringify(layerToSubviewKey)}></script>
    <script type="application/json" is:inline id="subview-svgs" set:html={JSON.stringify(subviews)}></script>
    <script type="application/json" is:inline id="evidence-payload" set:html={JSON.stringify(evidencePayload)}></script>

    <div id="layer-detail" class="layer-detail" hidden data-testid="layer-detail">
      <div class="ld-top">
        <strong><span data-i18n="detail.layerPrefix">Layer</span> <span id="ld-index" class="mono"></span></strong>
        <span class="pill pill-ar" id="ld-attention"></span>
        <span class="pill pill-moe" id="ld-ffn"></span>
      </div>
      <div class="ld-modules muted mono" id="ld-modules"></div>
      <div class="muted mono" id="ld-evidence"></div>
    </div>

    <p class="legend muted">
      <span class="key"><span class="cell" style="background:var(--attention)" /> <span data-i18n="detail.legendAttn">attention (GQA / MLA / Full)</span></span>
      <span class="key"><span class="cell" style="background:var(--state)" /> <span data-i18n="detail.legendLinear">linear / sliding window</span></span>
      <span class="key"><span class="cell" style="background:var(--compute)" /> <span data-i18n="detail.legendMoe">MoE</span></span>
      <span class="key"><span class="cell" style={`background:${isSystemOne ? "var(--decision)" : "var(--line)"}`} /> <span data-i18n={isSystemOne ? "detail.legendDenseS1" : "detail.legendDense"}>{isSystemOne ? "dense FFN (System-1)" : "dense FFN"}</span></span>
    </p>
  </section>

  <!-- Contextual Citation Panel (#38) -->
  <section class="section citation-panel" id="citation-panel" data-testid="citation-panel" aria-live="polite">
    <div class="section-bar">
      <div>
        <h2 data-i18n="detail.citationPanel">Contextual Citation Inspector</h2>
        <p class="muted small-note" id="citation-subtitle" data-i18n="detail.citationDefaultNote">
          Select any diagram node, specification card, or genome layer to inspect exact-model sources vs mechanism references.
        </p>
      </div>
      <button type="button" id="clear-citation" class="btn btn-subtle" hidden data-i18n="detail.clearCitation">Clear selection</button>
    </div>

    <div id="citation-cards" class="citation-cards">
      {brief && (
        <div class="provenance-overview">
          <div class="prov-group">
            <span class="eyebrow" data-i18n="detail.provPrimary">Exact-Model Primary Sources</span>
            <ul class="prov-list">
              {brief.primary_sources.map((src) => (
                <li>
                  <span class="scope-pill scope-exact" data-i18n="detail.scopeExact">✓ exact model</span>
                  <a href={src.url} rel="noopener noreferrer">{src.kind}</a>
                  <code class="rev-chip">{src.revision.slice(0, 10)}</code>
                  {src.sha256 && <span class="muted mono small-hash">sha256:{src.sha256.slice(0, 12)}</span>}
                </li>
              ))}
            </ul>
          </div>
          {brief.papers.length > 0 && (
            <div class="prov-group">
              <span class="eyebrow" data-i18n="detail.provPapers">Paper References & Mechanism Scope</span>
              <ul class="prov-list">
                {brief.papers.map((p) => (
                  <li>
                    <span
                      class={`scope-pill ${p.role === "model-specific" ? "scope-exact" : "scope-mech"}`}
                      data-i18n={p.role === "model-specific" ? "detail.scopeModelSpecific" : "detail.scopeMech"}
                    >
                      {p.role === "model-specific" ? "✓ model-specific" : "◐ mechanism-only"}
                    </span>
                    <a href={p.url} rel="noopener noreferrer">{p.title}</a>
                    <span class="muted"> · {p.locators.join(", ")}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- Full Evidence Ledger in an accessible disclosure (#38) -->
  <section class="section">
    <details id="evidence-ledger" class="ledger-disclosure">
      <summary class="ledger-summary">
        <div>
          <div>
            <strong data-i18n="detail.advancedLedger">Advanced: Full Evidence Ledger</strong>
            <span class="muted mono" data-i18n="detail.claimsCount" data-n={String(evidence.claims.length)}>({evidence.claims.length} claims)</span>
          </div>
          <p class="muted small-note" data-i18n="detail.evidenceNote">
            Every visible number resolves to an immutable source claim. Expand to filter or audit raw paths.
          </p>
        </div>
      </summary>

      <div class="ledger-body">
        <div class="ev-filters" role="group" aria-label="Filter evidence status">
          <button type="button" class="ev-tab active" data-status="">
            <span data-i18n="detail.evidenceAll">All</span> ({evidence.claims.length})
          </button>
          {Object.entries(statusCounts).map(([st, cnt]) => (
            <button type="button" class="ev-tab" data-status={st}>
              <span data-i18n={`statusWord.${st}`}>{st}</span> ({cnt})
            </button>
          ))}
        </div>

        <div class="evidence-wrap" data-atlas-scroll="x">
          <table class="evidence">
            <thead>
              <tr>
                <th data-i18n="detail.claim">Claim</th>
                <th data-i18n="detail.value">Value</th>
                <th data-i18n="detail.status">Status</th>
                <th data-i18n="detail.source">Source</th>
              </tr>
            </thead>
            <tbody>
              {evidence.claims.map((c) => (
                <tr data-claim-status={c.status} data-claim-row={c.path}>
                  <td data-label="Claim"><code>{c.path}</code></td>
                  <td data-label="Value" class="mono">{c.status === "unknown" ? "—" : JSON.stringify(c.value)}</td>
                  <td data-label="Status"><span class={`chip chip-${c.status}`} data-i18n={`status.${c.status}`}>{statusSymbol(c.status)} {c.status}</span></td>
                  <td data-label="Source">
                    {c.source?.url ? <a href={c.source.url} rel="noopener noreferrer">{c.source.kind}</a> : c.source?.kind}
                    {c.source?.locator && <span class="muted"> · {c.source.locator}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </details>
  </section>

  <section class="section">
    <h2 data-i18n="detail.compare">Compare</h2>
    <p class="muted" data-i18n="detail.compareNote">Launch a side-by-side comparison with any other model in the atlas.</p>
    <div class="compare-chips">
      {otherOptions.map((o) => (
        <a class="btn" href={o.pairUrl}>vs {o.label}</a>
      ))}
    </div>
  </section>

  <script>
    import { currentLang, t, translateRoot } from "../../scripts/i18n";
    import { localizeSvg, localizeSvgText } from "../../scripts/svg-i18n";

    type SubviewEntry = { title: string; subtitle: string; svg: string };
    type ClaimItem = {
      path: string;
      value: unknown;
      status: string;
      source?: { kind?: string; url?: string; revision?: string; locator?: string };
    };
    type BriefPaper = { url: string; title: string; role: string; locators: string[] };
    type EvidencePayload = {
      model: { id: string; label: string; revision: string };
      ir_version: string;
      paradigm: string;
      facts: {
        num_hidden_layers: number;
        hidden_size: number;
        num_attention_heads: number;
        num_key_value_heads?: number | null;
        head_dim?: number | null;
        vocab_size?: number | null;
        context_tokens?: number | null;
        total_params?: number | null;
        active_params?: number | null;
      };
      topology: {
        attention_groups: Array<{ kind: string; label: string; layers: number[] }>;
        ffn_groups: Array<{ label: string; layers: number[] }>;
        experts?: { routed_total?: number | null; active_routed?: number | null; shared?: number | null } | null;
        decision_head?: { readout_mode?: string; calibration?: string | null } | null;
      };
      claims: ClaimItem[];
      brief: { papers?: BriefPaper[] } | null;
    };

    const attnLabels = JSON.parse(document.getElementById("attn-labels")!.textContent!) as string[];
    const ffnLabels = JSON.parse(document.getElementById("ffn-labels")!.textContent!) as string[];
    const layerSubMap = JSON.parse(document.getElementById("layer-subview-map")!.textContent!) as Record<string, string>;
    const subviewSvgs = JSON.parse(document.getElementById("subview-svgs")!.textContent!) as Record<string, SubviewEntry>;
    const payload = JSON.parse(document.getElementById("evidence-payload")!.textContent!) as EvidencePayload;
    const claimByPath = new Map(payload.claims.map((c) => [c.path, c]));

    // Compare dropdown jump
    const compareSelect = document.getElementById("compare-target") as HTMLSelectElement | null;
    compareSelect?.addEventListener("change", () => {
      if (compareSelect.value) location.href = compareSelect.value;
    });

    // Zoom mode buttons (Fit / 1:1 Pan / 135%) applied symmetrically to active canvas
    const figureWrap = document.getElementById("figure-wrap");
    const subviewCanvas = document.getElementById("subview-canvas");
    const viewButtons = [...document.querySelectorAll<HTMLButtonElement>(".vbtn")];
    function setZoomMode(mode: string) {
      [figureWrap, subviewCanvas].forEach((wrap) => {
        if (!wrap) return;
        wrap.classList.remove("mode-fit", "mode-pan", "mode-zoom");
        wrap.classList.add(`mode-${mode}`);
      });
      viewButtons.forEach((b) => b.classList.toggle("active", b.dataset.viewMode === mode));
    }
    viewButtons.forEach((btn) =>
      btn.addEventListener("click", () => setZoomMode(btn.dataset.viewMode ?? "fit")),
    );

    // State variables synced with URL (?view=...&layer=...&claim=...)
    const overviewStage = document.getElementById("overview-stage")!;
    const subviewStage = document.getElementById("subview-stage")!;
    const subTitle = document.getElementById("subview-title")!;
    const subSubtitle = document.getElementById("subview-subtitle")!;
    const resetOverviewBtn = document.getElementById("reset-overview-btn") as HTMLButtonElement | null;
    const vtabs = [...document.querySelectorAll<HTMLButtonElement>(".vtab")];
    const tabBlockIdx = document.getElementById("tab-block-idx")!;

    const genomeEl = document.querySelector<HTMLElement>(".genome");
    const detail = document.getElementById("layer-detail")!;
    const clearLayerBtn = document.getElementById("clear-layer") as HTMLButtonElement | null;
    const cols = [...document.querySelectorAll<HTMLElement>(".genome .col")];
    const ledgerDetails = document.getElementById("evidence-ledger") as HTMLDetailsElement | null;
    const evidenceRows = [...document.querySelectorAll<HTMLTableRowElement>("table.evidence tbody tr")];

    const citSubtitle = document.getElementById("citation-subtitle")!;
    const citCards = document.getElementById("citation-cards")!;
    const clearCitBtn = document.getElementById("clear-citation") as HTMLButtonElement | null;
    const defaultCitationHtml = citCards.innerHTML;
    const defaultCitSubtitle = citSubtitle.textContent ?? "";

    let currentView = "overview";
    let currentLayer: number | null = null;
    let currentClaims: string[] = [];
    let currentCitationLabel = "";
    let activeStatusFilter = "";
    let cachedOverviewSvg: string | null = null;

    async function syncOverviewDiagramLang() {
      const img = document.querySelector<HTMLImageElement>("#overview-stage img.diagram-img");
      if (!img) return;
      const enSrc = img.dataset.enSrc ?? img.getAttribute("src") ?? "";
      if (!enSrc) return;
      const lang = currentLang();
      if (lang === "en") {
        if (img.getAttribute("src") !== enSrc) img.setAttribute("src", enSrc);
        return;
      }
      try {
        if (!cachedOverviewSvg) {
          cachedOverviewSvg = await fetch(enSrc).then((r) => r.text());
        }
        const zhSvg = localizeSvg(cachedOverviewSvg, "zh");
        if (currentLang() === "zh") {
          img.setAttribute("src", `data:image/svg+xml;charset=utf-8,${encodeURIComponent(zhSvg)}`);
        }
      } catch {
        // fallback cleanly to English SVG if fetch fails
      }
    }

    function syncUrl(push = false) {
      const params = new URLSearchParams();
      if (currentView !== "overview") params.set("view", currentView);
      if (currentLayer !== null) params.set("layer", String(currentLayer));
      if (currentClaims.length > 0) params.set("claim", currentClaims[0]!);
      const qLang = new URLSearchParams(location.search).get("lang");
      if (qLang === "zh" || qLang === "en") params.set("lang", qLang);
      const next = params.toString() ? `?${params}` : location.pathname;
      if (push) history.pushState(null, "", next);
      else history.replaceState(null, "", next);
    }

    function esc(s: string): string {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function applyEvidenceFilter() {
      evidenceRows.forEach((row) => {
        const path = row.querySelector("code")?.textContent ?? "";
        const status = row.dataset.claimStatus ?? "";
        const statusOk = !activeStatusFilter || status === activeStatusFilter;
        row.hidden = !statusOk;
        const match = currentClaims.length > 0 && currentClaims.some((p) => path === p || path.startsWith(p));
        row.classList.toggle("dimmed", currentClaims.length > 0 && !match);
        row.classList.toggle("highlighted", match);
      });
    }

    const STATUS_GLYPHS: Record<string, string> = {
      verified: "✓",
      reported: "•",
      derived: "=",
      inferred: "?",
      conflict: "!",
      unknown: "?",
    };
    const STATUS_ZH: Record<string, string> = {
      verified: "已验证",
      reported: "文献报告",
      derived: "推导",
      inferred: "推断",
      conflict: "冲突",
      unknown: "未知",
    };

    function renderCitations(label: string, paths: string[]) {
      currentCitationLabel = label;
      currentClaims = paths.filter((p) => claimByPath.has(p));
      applyEvidenceFilter();

      document.querySelectorAll<HTMLElement>(".hotspot").forEach((hs) => {
        const hsPaths = (hs.dataset.claimPaths ?? "").split(",").filter(Boolean);
        hs.classList.toggle("active", Boolean(label) && hsPaths.some((p) => currentClaims.includes(p)));
      });

      const lang = currentLang();
      const isZh = lang === "zh";
      if (!currentClaims.length) {
        citSubtitle.textContent = isZh ? t("detail.citationDefaultNote", "zh") : defaultCitSubtitle;
        citCards.innerHTML = defaultCitationHtml;
        translateRoot(citCards, lang);
        if (clearCitBtn) clearCitBtn.hidden = true;
        return;
      }

      if (clearCitBtn) clearCitBtn.hidden = false;
      citSubtitle.textContent = isZh
        ? `当前展示与「${label}」关联的 ${currentClaims.length} 条溯源证据：`
        : `Showing ${currentClaims.length} evidence claim(s) linked to "${label}":`;
      const html = currentClaims
        .map((p) => {
          const c = claimByPath.get(p)!;
          const isExact = c.source?.kind !== "tech_report";
          const val = c.status === "unknown" ? "—" : JSON.stringify(c.value);
          const rev = c.source?.revision ? c.source.revision.slice(0, 10) : payload.model.revision;
          const loc = c.source?.locator ?? "source definition";
          const url = c.source?.url;
          const glyph = STATUS_GLYPHS[c.status] ?? "?";
          const statusLabel = isZh ? (STATUS_ZH[c.status] ?? c.status) : c.status;
          const scopeLabel = isExact ? t("detail.scopeExact", lang) : t("detail.scopeMech", lang);
          const ledgerBtnLabel = isZh ? "台账 ↗" : "Ledger ↗";
          return `
            <article class="cit-card">
              <div class="cit-top">
                <span class="chip chip-${esc(c.status)}">${glyph} ${esc(statusLabel)}</span>
                <span class="scope-pill ${isExact ? "scope-exact" : "scope-mech"}">${scopeLabel}</span>
                <code class="rev-chip">${esc(rev)}</code>
              </div>
              <div class="cit-val mono">${esc(val)}</div>
              <div class="cit-loc">
                ${url ? `<a href="${esc(url)}" rel="noopener noreferrer">${esc(c.source?.kind ?? "source")}</a>` : `<span>${esc(c.source?.kind ?? "source")}</span>`}
                <span class="muted"> · ${esc(loc)}</span>
              </div>
              <div class="cit-foot">
                <code class="cit-path">${esc(c.path)}</code>
                <button type="button" class="btn-mini ledger-jump" data-jump-path="${esc(c.path)}">${ledgerBtnLabel}</button>
              </div>
            </article>
          `;
        })
        .join("");
      citCards.innerHTML = `<div class="cit-grid">${html}</div>`;
      citCards.querySelectorAll<HTMLButtonElement>(".ledger-jump").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (ledgerDetails) ledgerDetails.open = true;
          const targetRow = evidenceRows.find((r) => r.dataset.claimRow === btn.dataset.jumpPath);
          const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
          targetRow?.scrollIntoView({ block: "center", behavior: reduced ? "auto" : "smooth" });
        });
      });
    }

    function attachSvgInteractivity(container: HTMLElement) {
      const svg = container.querySelector<SVGSVGElement>("svg");
      const hsLayer = container.querySelector<HTMLElement>(".hotspot-layer");
      const vb = svg?.viewBox.baseVal;
      const clampVal = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

      container
        .querySelectorAll<SVGGElement | SVGPathElement>(
          ".node[data-claim-path], .node[data-claims], .grp[data-claim-path], path[data-edge-id][data-claim-path]",
        )
        .forEach((el) => {
          const cp = el.dataset.claimPath ?? "";
          const paths: string[] = [];
          let label = el.querySelector("text")?.textContent?.trim() ?? "";
          if (el.dataset.claims) {
            try {
              const parsed = JSON.parse(el.dataset.claims) as Array<{ claimPath?: string; label?: string }>;
              for (const item of parsed) {
                if (item.claimPath && !paths.includes(item.claimPath)) paths.push(item.claimPath);
              }
              if (!label && parsed[0]?.label) label = parsed[0].label;
            } catch {
              // ignore malformed claims JSON
            }
          }
          if (cp && !paths.includes(cp)) paths.unshift(cp);
          if (paths.length === 0) return;
          if (!label) label = el.dataset.edgeId ?? paths[0]!;

          el.setAttribute("tabindex", "0");
          el.setAttribute("role", "button");
          el.style.cursor = "pointer";
          const trigger = () => {
            renderCitations(label, paths);
            syncUrl(false);
          };
          el.addEventListener("click", trigger);
          el.addEventListener("keydown", (ev) => {
            if (!(ev instanceof KeyboardEvent)) return;
            if (ev.key === "Enter" || ev.key === " ") {
              ev.preventDefault();
              trigger();
            }
          });

          if (el instanceof SVGPathElement && el.dataset.edgeId && hsLayer && vb && vb.width > 0 && vb.height > 0) {
            try {
              const len = el.getTotalLength();
              const pt = el.getPointAtLength(len / 2);
              const btn = document.createElement("button");
              btn.type = "button";
              btn.className = "hotspot hotspot-edge";
              btn.style.left = `${clampVal((pt.x / vb.width) * 100, 2, 98).toFixed(3)}%`;
              btn.style.top = `${clampVal((pt.y / vb.height) * 100, 3, 97).toFixed(3)}%`;
              btn.style.width = "2.4%";
              btn.style.height = "3.6%";
              btn.dataset.edgeId = el.dataset.edgeId;
              btn.dataset.claimPaths = paths.join(",");
              btn.dataset.label = label;
              btn.setAttribute("aria-label", `${label} — inspect citation`);
              btn.title = label;
              btn.addEventListener("click", trigger);
              hsLayer.appendChild(btn);
            } catch {
              // ignore if path geometry unavailable
            }
          }
        });
    }

    function activateSubview(view: string, layerIdx: number | null, push = true) {
      currentView = view;
      vtabs.forEach((t) => {
        const active = t.dataset.subview === view;
        t.classList.toggle("active", active);
        t.setAttribute("aria-selected", active ? "true" : "false");
      });
      if (resetOverviewBtn) resetOverviewBtn.hidden = view === "overview";

      if (view === "overview") {
        overviewStage.hidden = false;
        subviewStage.hidden = true;
        if (push) syncUrl(true);
        return;
      }

      let subKey = `module:${view}`;
      if (view === "block") {
        const idx = layerIdx ?? currentLayer ?? 0;
        currentLayer = idx;
        tabBlockIdx.textContent = `L${idx}`;
        subKey = layerSubMap[String(idx)] ?? layerSubMap["0"]!;
      }

      const sub = subviewSvgs[subKey];
      if (!sub) {
        activateSubview("overview", currentLayer, push);
        return;
      }
      overviewStage.hidden = true;
      subviewStage.hidden = false;
      const lang = currentLang();
      subTitle.textContent =
        view === "block" && currentLayer !== null
          ? t("subview.block", lang, { n: String(currentLayer) })
          : localizeSvgText(sub.title, lang);
      subSubtitle.textContent = localizeSvgText(sub.subtitle, lang);
      subviewCanvas!.innerHTML = `<div class="figure-inner">${localizeSvg(sub.svg, lang)}<div class="hotspot-layer" aria-label="Interactive subview edge claims"></div></div>`;
      attachSvgInteractivity(subviewCanvas!);
      if (push) syncUrl(true);
    }

    function selectLayer(i: number, opts: { scroll?: boolean; switchView?: boolean; push?: boolean } = {}) {
      const col = cols[i];
      if (!col) return;
      const layerNum = Number(col.dataset.layer!);
      currentLayer = layerNum;
      cols.forEach((c) => c.setAttribute("aria-selected", "false"));
      col.setAttribute("aria-selected", "true");
      tabBlockIdx.textContent = `L${layerNum}`;

      const lang = currentLang();
      const attn = col.dataset.attention!;
      const ffn = col.dataset.ffn!;
      const aMod = col.dataset.attnModule ?? "";
      const fMod = col.dataset.ffnModule ?? "";
      document.getElementById("ld-index")!.textContent = String(layerNum);
      document.getElementById("ld-attention")!.textContent = attn;
      document.getElementById("ld-ffn")!.textContent = ffn;
      document.getElementById("ld-modules")!.textContent =
        lang === "zh" ? `注意力模块: ${aMod} · FFN 模块: ${fMod}` : `attention: ${aMod} · ffn: ${fMod}`;

      const matchedPaths = [
        `topology.attention_groups[${attnLabels.indexOf(attn)}]`,
        `topology.ffn_groups[${ffnLabels.indexOf(ffn)}]`,
      ].filter((p) => !p.includes("-1"));
      document.getElementById("ld-evidence")!.textContent = matchedPaths.length
        ? `${lang === "zh" ? "关联声明" : "linked claims"}: ${matchedPaths.join(", ")}`
        : "";
      detail.hidden = false;
      if (clearLayerBtn) clearLayerBtn.hidden = false;

      renderCitations(
        lang === "zh" ? `第 ${layerNum} 层 (${attn} + ${ffn})` : `Layer ${layerNum} (${attn} + ${ffn})`,
        matchedPaths,
      );
      if (opts.switchView !== false) {
        activateSubview("block", layerNum, opts.push ?? true);
      } else if (opts.push) {
        syncUrl(true);
      } else {
        syncUrl(false);
      }
      if (opts.scroll) {
        subviewStage.scrollIntoView({ block: "nearest", behavior: "auto" });
      }
    }

    function clearLayer(returnOverview = true) {
      cols.forEach((c) => c.setAttribute("aria-selected", "false"));
      currentLayer = null;
      detail.hidden = true;
      if (clearLayerBtn) clearLayerBtn.hidden = true;
      renderCitations("", []);
      if (returnOverview) activateSubview("overview", null, true);
      else syncUrl(false);
    }

    // Bind UI triggers
    vtabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const sub = tab.dataset.subview ?? "overview";
        if (sub === "block" && currentLayer === null) selectLayer(0, { switchView: true, push: true });
        else activateSubview(sub, currentLayer, true);
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".m-sub-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.jumpSubview ?? "attention";
        if (target === "block") selectLayer(currentLayer ?? 0, { switchView: true, push: true });
        else activateSubview(target, currentLayer, true);
        subviewStage.scrollIntoView({ block: "start", behavior: "auto" });
      });
    });

    resetOverviewBtn?.addEventListener("click", () => activateSubview("overview", currentLayer, true));
    clearLayerBtn?.addEventListener("click", () => clearLayer(true));
    clearCitBtn?.addEventListener("click", () => {
      renderCitations("", []);
      syncUrl(false);
    });

    document.querySelectorAll<HTMLButtonElement>(".hotspot, .fact-btn").forEach((el) => {
      el.addEventListener("click", () => {
        const paths = (el.dataset.claimPaths ?? "").split(",").filter(Boolean);
        renderCitations(el.dataset.label ?? "Selection", paths);
        syncUrl(false);
      });
    });

    cols.forEach((col, i) => col.addEventListener("click", () => selectLayer(i, { switchView: true, push: true })));
    genomeEl?.addEventListener("keydown", (ev) => {
      const cur = cols.findIndex((c) => c.getAttribute("aria-selected") === "true");
      if (ev.key === "ArrowRight") { selectLayer(Math.min(cur + 1, cols.length - 1)); ev.preventDefault(); }
      if (ev.key === "ArrowLeft") { selectLayer(Math.max(cur - 1, 0)); ev.preventDefault(); }
      if (ev.key === "Home") { selectLayer(0); ev.preventDefault(); }
      if (ev.key === "End") { selectLayer(cols.length - 1); ev.preventDefault(); }
      if (ev.key === "Escape") { clearLayer(true); ev.preventDefault(); }
    });

    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && currentView !== "overview") {
        activateSubview("overview", currentLayer, true);
      }
    });

    // Evidence ledger status filter tabs
    const evTabs = [...document.querySelectorAll<HTMLButtonElement>(".ev-tab")];
    evTabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        activeStatusFilter = tab.dataset.status ?? "";
        evTabs.forEach((t) => t.classList.toggle("active", t === tab));
        applyEvidenceFilter();
      }),
    );

    // URL restore on initial load & browser back/forward (popstate)
    function restoreFromUrl() {
      const params = new URLSearchParams(location.search);
      const rawView = params.get("view") ?? "overview";
      const qView = rawView === "moe" ? "ffn" : rawView;
      const qLayer = params.get("layer");
      const qClaim = params.get("claim");
      currentView = qView;

      if (qLayer !== null && Number.isInteger(Number(qLayer)) && Number(qLayer) >= 0 && Number(qLayer) < cols.length) {
        selectLayer(Number(qLayer), { switchView: qView === "block", push: false });
      } else {
        currentLayer = null;
        detail.hidden = true;
        cols.forEach((c) => c.setAttribute("aria-selected", "false"));
      }

      if (qView !== "block" || currentLayer === null) {
        activateSubview(qView, currentLayer, false);
      }

      if (qClaim && claimByPath.has(qClaim)) {
        renderCitations(qClaim, [qClaim]);
      } else if (qLayer === null) {
        renderCitations("", []);
      }

      syncUrl(false);
    }

    restoreFromUrl();
    syncOverviewDiagramLang();
    window.addEventListener("popstate", restoreFromUrl);
    window.addEventListener("atlas:langchange", () => {
      syncOverviewDiagramLang();
      if (currentView !== "overview") {
        activateSubview(currentView, currentLayer, false);
      }
      if (currentLayer !== null) {
        selectLayer(currentLayer, { switchView: false, push: false });
      } else {
        renderCitations(currentCitationLabel, currentClaims);
      }
      syncFlowLang?.();
      renderKvEstimator?.();
    });

    // Canonical PNG, SVG, and Evidence Manifest exporters (decoupled from view zoom/focus state)
    document.querySelectorAll<HTMLButtonElement>(".png-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement("canvas");
          canvas.width = (img.naturalWidth || 1360) * 2;
          canvas.height = (img.naturalHeight || 860) * 2;
          const ctx = canvas.getContext("2d")!;
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob((blob) => {
            const a = document.createElement("a");
            a.href = URL.createObjectURL(blob!);
            a.download = `${btn.dataset.name}.png`;
            a.click();
            URL.revokeObjectURL(a.href);
          }, "image/png");
        };
        img.src = btn.dataset.fig!;
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".copy-svg-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const rawText = await fetch(btn.dataset.fig!).then((r) => r.text());
        const text = localizeSvg(rawText, currentLang());
        await navigator.clipboard?.writeText(text);
        btn.textContent = `✓ ${t("detail.copied")}`;
        setTimeout(() => { btn.textContent = t("detail.copySvg"); }, 1400);
      });
    });

    document.getElementById("export-manifest-btn")?.addEventListener("click", (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const blob = new Blob([JSON.stringify(payload, null, 2) + "\n"], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `${btn.dataset.name}-evidence-manifest.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // -------------------------------------------------------------------------
    // Token Flow Replay HUD (ModelMap-inspired deterministic execution tour)
    // -------------------------------------------------------------------------
    const flowToggleBtn = document.getElementById("flow-toggle") as HTMLButtonElement | null;
    const flowPrevBtn = document.getElementById("flow-prev") as HTMLButtonElement | null;
    const flowNextBtn = document.getElementById("flow-next") as HTMLButtonElement | null;
    const flowStopBtn = document.getElementById("flow-stop") as HTMLButtonElement | null;
    const flowHud = document.getElementById("flow-hud") as HTMLElement | null;
    const flowStepBadge = document.getElementById("flow-step-badge") as HTMLElement | null;
    const flowCaption = document.getElementById("flow-caption") as HTMLElement | null;

    const pFacts = payload.facts;
    const pTopo = payload.topology;
    const attnGrpLabel = (pTopo.attention_groups ?? []).map((g: any) => `${g.layers.length}× ${g.label}`).join(" + ");
    const ffnGrpLabel = (pTopo.ffn_groups ?? []).map((g: any) => `${g.layers.length}× ${g.label}`).join(" → ");
    const isS1 = payload.paradigm === "system_one_decision";
    const ctxVal = pFacts.context_tokens ?? 32768;

    const FLOW_STEPS: Array<{ ids: string[]; claim: string; en: string; zh: string }> = isS1
      ? [
          {
            ids: ["input", "embed"],
            claim: "topology.decision_head.primitives",
            en: `Pack State + Typed Questions into d=${(pFacts.hidden_size ?? 0).toLocaleString("en-US")} stream (zero decode loop).`,
            zh: `将当前状态与类型化问题映射为 d=${(pFacts.hidden_size ?? 0).toLocaleString("en-US")} 向量流（无自回归解码循环）。`,
          },
          {
            ids: ["blk-in", "blk-norm1", "blk-attn", "blk-mod", "blk-add1"],
            claim: "topology.attention_groups[0]",
            en: `Run ${pFacts.num_hidden_layers}L backbone (${attnGrpLabel}) with Pre-Norm residual skip rail.`,
            zh: `执行 ${pFacts.num_hidden_layers} 层骨干（${attnGrpLabel}）及前置归一化跳连。`,
          },
          {
            ids: ["r-pack", "r-gather", "r-act", "r-prefix", "r-slice", "r-scale", "a-g0", "a-g1"],
            claim: "topology.decision_head.readout_mode",
            en: `System-1 readout (${pTopo.decision_head?.readout_mode ?? "single-pass"}): extract option representations directly.`,
            zh: `System-1 读出（${pTopo.decision_head?.readout_mode ?? "单步前向"}）：直接提取各候选决策位表示。`,
          },
          {
            ids: ["blk-fork2", "blk-norm2", "blk-ffn", "blk-add2", "ffn-gate", "ffn-act", "ffn-up", "ffn-mul", "ffn-down"],
            claim: "facts.hidden_size",
            en: `Evaluate gated FFN diamond (d=${(pFacts.hidden_size ?? 0).toLocaleString("en-US")}: Gate · Act ⊙ Up → Down) and merge residual.`,
            zh: `执行门控 FFN 张量计算（d=${(pFacts.hidden_size ?? 0).toLocaleString("en-US")}: Gate · 激活 ⊙ Up → Down）并合并残差。`,
          },
          {
            ids: ["dhead", "prefill", "cal", "out", "c-obj", "c-scale"],
            claim: "topology.decision_head.calibration",
            en: `Apply proper calibration (${pTopo.decision_head?.calibration ?? "temperature scaling"}) → emit Typed JSON.`,
            zh: `经过严格概率校准（${pTopo.decision_head?.calibration ?? "温度缩放"}）直接输出强类型 JSON 概率。`,
          },
        ]
      : [
          {
            ids: ["tok", "embed"],
            claim: "facts.hidden_size",
            en: `Embed token IDs into hidden dimension d=${(pFacts.hidden_size ?? 0).toLocaleString("en-US")}.`,
            zh: `将输入 Token ID 经词嵌入投影为 d=${(pFacts.hidden_size ?? 0).toLocaleString("en-US")} 隐藏向量。`,
          },
          {
            ids: ["blk-in", "blk-norm1", "blk-attn", "blk-mod"],
            claim: "topology.attention_groups[0]",
            en: `Inside Transformer Block (${pFacts.num_hidden_layers}×): fork skip rail, Pre-Attn RMSNorm → ${attnGrpLabel}.`,
            zh: `进入 Transformer 模块（共 ${pFacts.num_hidden_layers} 层）：分出残差跳连，Pre-Attn Norm → ${attnGrpLabel}。`,
          },
          {
            ids: ["attn-q", "attn-rope", "attn-kv", "attn-proj", "attn-core", "attn-out", "kda-qkv", "kda-decay", "kda-state", "kda-gate", "lin-qkv", "lin-decay", "lin-state", "lin-gate", "mla-kv", "mla-rope", "mla-core", "gqa-q", "gqa-kv", "gqa-core", "p-0", "p-1", "p-2", "p-3", "p-4"],
            claim: "facts.num_attention_heads",
            en: `Attention / Mixer tensors (${pFacts.num_attention_heads} Q heads): projections, positional RoPE, state/KV & O-Proj.`,
            zh: `注意力/混合器细节（${pFacts.num_attention_heads} Q 头）：投影矩阵、位置编码、KV/循环状态更新与输出投影。`,
          },
          {
            ids: ["blk-add1", "blk-fork2", "blk-norm2"],
            claim: "facts.num_hidden_layers",
            en: `Add post-attention residual (h + attn), fork second skip rail, apply Pre-FFN RMSNorm.`,
            zh: `执行注意力残差相加 (h + attn)，分出第二路跳连，并执行 FFN 前 RMSNorm。`,
          },
          {
            ids: ["blk-ffn", "blk-add2", "ffn-gate", "ffn-act", "ffn-up", "ffn-mul", "ffn-down", "moe-router", "moe-routed", "moe-shared", "moe-merge", "moe-swiglu", "p-5", "p-6", "p-7", "p-8", "p-9", "p-10"],
            claim: pTopo.experts?.routed_total ? "topology.experts.routed_total" : "facts.hidden_size",
            en: `FFN / MoE step (${ffnGrpLabel}) → elementwise SwiGLU/MoE merge & h + FFN residual.`,
            zh: `FFN / MoE 阶段（${ffnGrpLabel}）：完成门控乘积/专家路由并相加写回残差。`,
          },
          {
            ids: ["norm", "head", "scale-ctx", "scale-params"],
            claim: "facts.vocab_size",
            en: `Final RMSNorm → LM head maps residual vector to logits (vocab ${(pFacts.vocab_size ?? 0).toLocaleString("en-US")}).`,
            zh: `最终 RMSNorm → LM head 将末端隐藏态映射至词表 logits（词表 ${(pFacts.vocab_size ?? 0).toLocaleString("en-US")}）。`,
          },
        ];

    let flowIdx = -1;
    let flowPlaying = false;
    let flowTimer: number | null = null;

    function clearFlowHighlights() {
      document.querySelectorAll<HTMLElement>("#overview-stage .hotspot.flow-hit").forEach((el) => {
        el.classList.remove("flow-hit");
      });
    }

    function applyFlowStep(index: number) {
      if (index < 0 || index >= FLOW_STEPS.length) return;
      if (currentView !== "overview") {
        activateSubview("overview", currentLayer, false);
      }
      flowIdx = index;
      const step = FLOW_STEPS[flowIdx]!;
      const idSet = new Set(step.ids);
      clearFlowHighlights();
      document.querySelectorAll<HTMLElement>("#overview-stage .hotspot[data-node-id]").forEach((hs) => {
        if (idSet.has(hs.dataset.nodeId ?? "")) hs.classList.add("flow-hit");
      });
      if (flowHud) flowHud.hidden = false;
      if (flowStepBadge) flowStepBadge.textContent = `${flowIdx + 1}/${FLOW_STEPS.length}`;
      const lang = currentLang();
      if (flowCaption) flowCaption.textContent = lang === "zh" ? step.zh : step.en;
      if (claimByPath.has(step.claim)) {
        renderCitations(lang === "zh" ? `数据流步骤 ${flowIdx + 1}` : `Flow Step ${flowIdx + 1}`, [step.claim]);
      }
    }

    function stopFlow() {
      flowPlaying = false;
      flowIdx = -1;
      if (flowTimer !== null) {
        window.clearInterval(flowTimer);
        flowTimer = null;
      }
      if (flowHud) flowHud.hidden = true;
      if (flowToggleBtn) {
        flowToggleBtn.classList.remove("active");
        flowToggleBtn.textContent = t("flow.play", currentLang());
      }
      clearFlowHighlights();
    }

    function syncFlowLang() {
      if (flowToggleBtn) {
        flowToggleBtn.textContent = t(flowPlaying ? "flow.pause" : "flow.play", currentLang());
      }
      if (flowIdx >= 0 && flowCaption) {
        const step = FLOW_STEPS[flowIdx]!;
        flowCaption.textContent = currentLang() === "zh" ? step.zh : step.en;
      }
    }

    flowToggleBtn?.addEventListener("click", () => {
      if (flowPlaying) {
        flowPlaying = false;
        if (flowTimer !== null) {
          window.clearInterval(flowTimer);
          flowTimer = null;
        }
        flowToggleBtn.classList.remove("active");
        flowToggleBtn.textContent = t("flow.play", currentLang());
        return;
      }
      flowPlaying = true;
      flowToggleBtn.classList.add("active");
      flowToggleBtn.textContent = t("flow.pause", currentLang());
      applyFlowStep(flowIdx >= 0 ? flowIdx : 0);
      const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
      const intervalMs = reducedMotion ? 2600 : 1850;
      flowTimer = window.setInterval(() => {
        applyFlowStep((flowIdx + 1) % FLOW_STEPS.length);
      }, intervalMs);
    });

    flowPrevBtn?.addEventListener("click", () => {
      if (flowPlaying && flowTimer !== null) {
        window.clearInterval(flowTimer);
        flowTimer = null;
        flowPlaying = false;
        flowToggleBtn?.classList.remove("active");
        if (flowToggleBtn) flowToggleBtn.textContent = t("flow.play", currentLang());
      }
      const next = flowIdx <= 0 ? FLOW_STEPS.length - 1 : flowIdx - 1;
      applyFlowStep(next);
    });

    flowNextBtn?.addEventListener("click", () => {
      if (flowPlaying && flowTimer !== null) {
        window.clearInterval(flowTimer);
        flowTimer = null;
        flowPlaying = false;
        flowToggleBtn?.classList.remove("active");
        if (flowToggleBtn) flowToggleBtn.textContent = t("flow.play", currentLang());
      }
      const next = (flowIdx + 1) % FLOW_STEPS.length;
      applyFlowStep(next);
    });

    flowStopBtn?.addEventListener("click", stopFlow);

    // -------------------------------------------------------------------------
    // KV Cache & Memory Estimator (100% IR Facts-Backed)
    // -------------------------------------------------------------------------
    const kvCtxBtns = [...document.querySelectorAll<HTMLButtonElement>(".kv-ctx-btn")];
    const kvPrecBtns = [...document.querySelectorAll<HTMLButtonElement>(".kv-prec-btn")];
    const kvWeightsEl = document.getElementById("kv-weights");
    const kvWeightsNoteEl = document.getElementById("kv-weights-note");
    const kvPerTokEl = document.getElementById("kv-pertok");
    const kvPerTokNoteEl = document.getElementById("kv-pertok-note");
    const kvTotalCacheEl = document.getElementById("kv-total-cache");
    const kvCacheNoteEl = document.getElementById("kv-cache-note");
    const kvTotalVramEl = document.getElementById("kv-total-vram");
    const kvFitNoteEl = document.getElementById("kv-fit-note");

    // Pick initial preset closest to native context window
    let selectedCtx = [4096, 32768, 131072, 1048576].reduce((best, c) =>
      Math.abs(c - Math.min(ctxVal, 131072)) < Math.abs(best - Math.min(ctxVal, 131072)) ? c : best,
      32768,
    );
    let selectedBytesPerParam = 2;
    let selectedPrecName = "BF16";

    function fmtGiB(bytes: number): string {
      const gib = bytes / 1024 ** 3;
      if (gib >= 100) return `${gib.toFixed(0)} GiB`;
      if (gib >= 10) return `${gib.toFixed(1)} GiB`;
      return `${gib.toFixed(2)} GiB`;
    }

    function renderKvEstimator() {
      const lang = currentLang();
      const isZh = lang === "zh";
      kvCtxBtns.forEach((b) => b.classList.toggle("active", Number(b.dataset.ctx) === selectedCtx));
      kvPrecBtns.forEach((b) => b.classList.toggle("active", b.dataset.prec === selectedPrecName));

      const totalParams = pFacts.total_params ?? null;
      const activeParams = pFacts.active_params ?? null;
      const weightsBytes = totalParams ? totalParams * selectedBytesPerParam : null;
      const weightsGibStr = weightsBytes !== null ? fmtGiB(weightsBytes) : "—";
      if (kvWeightsEl) kvWeightsEl.textContent = weightsGibStr;
      if (kvWeightsNoteEl) {
        if (totalParams && activeParams && activeParams < totalParams) {
          kvWeightsNoteEl.textContent = isZh
            ? `${selectedPrecName} 总权重 · 激活 ${(activeParams / 1e9).toFixed(1)}B (${fmtGiB(activeParams * selectedBytesPerParam)} 活跃)`
            : `${selectedPrecName} total · ${(activeParams / 1e9).toFixed(1)}B active`;
        } else {
          kvWeightsNoteEl.textContent = totalParams ? `${selectedPrecName} (${(totalParams / 1e9).toFixed(2)}B params)` : isZh ? "缺少总参数声明" : "total_params missing";
        }
      }

      const attnGroups: any[] = pTopo.attention_groups ?? [];
      const linLayers = attnGroups.filter((g) => g.kind === "linear_attention").reduce((s, g) => s + g.layers.length, 0);
      const mlaLayers = attnGroups.filter((g) => g.kind === "mla" || g.kind === "mla_sparse").reduce((s, g) => s + g.layers.length, 0);
      const swaGroupList = attnGroups.filter((g) => g.kind === "sliding_window");
      const swaLayers = swaGroupList.reduce((s, g) => s + g.layers.length, 0);
      const parsedSwaWin = swaGroupList.reduce<number | null>((acc, g) => {
        const m = String(g.label ?? "").match(/w\s*=\s*(\d+)/i);
        return m ? Number(m[1]) : acc;
      }, null);
      const stdKvLayers = attnGroups.filter((g) => g.kind === "full" || g.kind === "gqa").reduce((s, g) => s + g.layers.length, 0);

      const kvHeads = pFacts.num_key_value_heads ?? null;
      const headDim = pFacts.head_dim ?? (pFacts.hidden_size && pFacts.num_attention_heads ? Math.floor(pFacts.hidden_size / pFacts.num_attention_heads) : null);
      const nativeCtx = pFacts.context_tokens ?? null;
      const ctxLbl = selectedCtx >= 1048576 ? "1M" : `${Math.round(selectedCtx / 1024)}K`;
      const exceedsNative = Boolean(nativeCtx && selectedCtx > nativeCtx);
      const exceedSuffix = exceedsNative
        ? (isZh ? `（超出原生 ${nativeCtx! >= 1024 ? `${Math.round(nativeCtx! / 1024)}K` : nativeCtx}）` : ` (> native ${nativeCtx! >= 1024 ? `${Math.round(nativeCtx! / 1024)}K` : nativeCtx})`)
        : "";

      if (mlaLayers > 0) {
        if (kvPerTokEl) kvPerTokEl.textContent = isZh ? "低秩潜空间 MLA" : "Compressed MLA";
        if (kvPerTokNoteEl) {
          kvPerTokNoteEl.textContent = linLayers > 0
            ? (isZh ? `${linLayers} 层线性(0 KV/tok) + ${mlaLayers} 层共享潜向量 KV` : `${linLayers} linear (0 KV/tok) + ${mlaLayers} MLA latent KV`)
            : (isZh ? `${mlaLayers} 层投影低秩 KV 潜向量（IR 未额外拆分 rank 维）` : `${mlaLayers} MLA layers cache low-rank latent KV`);
        }
        if (kvTotalCacheEl) kvTotalCacheEl.textContent = "≪ GQA upper bound";
        if (kvCacheNoteEl) {
          kvCacheNoteEl.textContent = isZh
            ? `${ctxLbl} 上下文${exceedSuffix} · 显著低于常规 MHA/GQA`
            : `${ctxLbl} ctx${exceedSuffix} · far below full K/V heads`;
        }
        if (kvTotalVramEl) kvTotalVramEl.textContent = weightsGibStr !== "—" ? `≥ ${weightsGibStr} + MLA KV` : "—";
        if (kvFitNoteEl) {
          const gpus80 = weightsBytes ? Math.max(1, Math.ceil(weightsBytes / (76 * 1024 ** 3))) : null;
          kvFitNoteEl.textContent = gpus80
            ? (isZh ? `仅权重约需 ${gpus80} × 80GB GPU (${selectedPrecName})` : `Weights ~${gpus80} × 80GB GPU (${selectedPrecName})`)
            : "";
        }
        return;
      }

      if (kvHeads && headDim && (stdKvLayers > 0 || swaLayers > 0)) {
        const bytesPerTokFull = stdKvLayers * 2 * kvHeads * headDim * 2; // BF16 K+V
        const effectiveSwaCtx = parsedSwaWin !== null ? Math.min(selectedCtx, parsedSwaWin) : selectedCtx;
        const swaBytes = swaLayers * 2 * kvHeads * headDim * 2 * effectiveSwaCtx;
        const totalCacheBytes = bytesPerTokFull * selectedCtx + swaBytes;
        const perTokExact = bytesPerTokFull + (swaLayers > 0 ? swaLayers * 2 * kvHeads * headDim * 2 : 0);

        if (kvPerTokEl) kvPerTokEl.textContent = `${(perTokExact / 1024).toFixed(1)} KiB/tok`;
        if (kvPerTokNoteEl) {
          kvPerTokNoteEl.textContent = linLayers > 0
            ? (isZh ? `${linLayers} 线性层(0 KV) + ${stdKvLayers} GQA×2×${kvHeads}×${headDim}×2B` : `${linLayers} linear (0 KV) + ${stdKvLayers}L × 2 × ${kvHeads}kv × ${headDim}d × 2B`)
            : swaLayers > 0
              ? (isZh ? `${stdKvLayers} 全注意 + ${swaLayers} 滑窗${parsedSwaWin ? ` (w=${parsedSwaWin})` : ""}` : `${stdKvLayers} full + ${swaLayers} SWA${parsedSwaWin ? ` (w=${parsedSwaWin})` : ""}`)
              : `${stdKvLayers}L × 2 × ${kvHeads}kv × ${headDim}d × 2B`;
        }
        if (kvTotalCacheEl) kvTotalCacheEl.textContent = fmtGiB(totalCacheBytes);
        if (kvCacheNoteEl) {
          kvCacheNoteEl.textContent = isZh ? `批次=1 @ ${ctxLbl} 上下文${exceedSuffix} (BF16 KV)` : `batch=1 @ ${ctxLbl} context${exceedSuffix} (BF16 KV)`;
        }
        const combinedBytes = weightsBytes !== null ? weightsBytes + totalCacheBytes : null;
        if (kvTotalVramEl) kvTotalVramEl.textContent = combinedBytes !== null ? fmtGiB(combinedBytes) : "—";
        if (kvFitNoteEl && combinedBytes !== null) {
          const g = combinedBytes / (1024 ** 3);
          kvFitNoteEl.textContent = g <= 22
            ? (isZh ? "适配单张 24GB 消费级 / L4 GPU" : "Fits 1 × 24GB GPU (e.g. 4090 / L4)")
            : g <= 76
              ? (isZh ? "适配单张 80GB A100 / H100" : "Fits 1 × 80GB A100 / H100")
              : (isZh ? `约需 ${Math.ceil(g / 76)} × 80GB GPU (${selectedPrecName})` : `Est. ${Math.ceil(g / 76)} × 80GB H100s (${selectedPrecName})`);
        }
      }
    }

    kvCtxBtns.forEach((b) =>
      b.addEventListener("click", () => {
        selectedCtx = Number(b.dataset.ctx);
        renderKvEstimator();
      }),
    );
    kvPrecBtns.forEach((b) =>
      b.addEventListener("click", () => {
        selectedBytesPerParam = Number(b.dataset.bytes);
        selectedPrecName = b.dataset.prec ?? "BF16";
        renderKvEstimator();
      }),
    );
    renderKvEstimator();
  </script>

