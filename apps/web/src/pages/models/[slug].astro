    :global(.cit-top) {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    :global(.cit-val) {
      font-size: 0.92rem;
      font-weight: 700;
      overflow-wrap: anywhere;
    }
    :global(.cit-loc) {
      font-size: 0.85rem;
      overflow-wrap: anywhere;
    }
    :global(.cit-foot) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 0.15rem;
      padding-top: 0.35rem;
      border-top: 1px solid var(--line-soft);
    }
    :global(.cit-path) {
      font-size: 0.78rem;
      color: var(--muted);
    }
    :global(.btn-mini) {
      min-height: 26px;
      padding: 0.18rem 0.55rem;
      border-radius: 6px;
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--ink);
      font: inherit;
      font-size: 0.76rem;
      font-weight: 700;
      cursor: pointer;
    }
    :global(.scope-pill) {
      border-radius: 999px;
      padding: 0.1rem 0.52rem;
      font-size: 0.74rem;
      font-weight: 700;
      white-space: nowrap;
    }
    :global(.scope-exact) {
      background: color-mix(in srgb, var(--state) 14%, var(--panel));
      color: var(--state);
      border: 1px solid color-mix(in srgb, var(--state) 35%, var(--line));
    }
    :global(.scope-mech) {
      background: color-mix(in srgb, var(--compute) 14%, var(--panel));
      color: var(--compute);
      border: 1px solid color-mix(in srgb, var(--compute) 35%, var(--line));
    }

    .ledger-disclosure {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--panel);
      box-shadow: var(--shadow-sm);
    }
    .ledger-summary {
      list-style: none;
      cursor: pointer;
      padding: 0.85rem 1.05rem;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 0.75rem;
      min-height: 36px;
    }
    .ledger-summary::-webkit-details-marker {
      display: none;
    }
    .ledger-summary::after {
      content: "▾";
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--attention);
    }
    .ledger-disclosure[open] .ledger-summary::after {
      content: "▴";
    }
    .ledger-body {
      padding: 0 1.05rem 1rem;
      border-top: 1px solid var(--line-soft);
      display: grid;
      gap: 0.75rem;
      padding-top: 0.75rem;
    }

    .ev-filters {
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
    }
    .ev-tab {
      min-height: 28px;
      font: inherit;
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--panel);
      color: var(--muted);
      cursor: pointer;
    }
    .ev-tab.active {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }

    .evidence-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--panel);
    }
    .evidence {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    .evidence th {
      background: var(--surface);
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }
    .evidence th,
    .evidence td {
      text-align: left;
      border-bottom: 1px solid var(--line-soft);
      padding: 0.55rem 0.75rem;
      vertical-align: top;
    }
    .evidence tbody tr.dimmed {
      opacity: 0.38;
    }
    .evidence tbody tr.highlighted {
      background: color-mix(in srgb, var(--attention) 8%, transparent);
    }
    .evidence tbody tr[hidden] {
      display: none;
    }

    :global(.chip) {
      border-radius: 999px;
      padding: 0.1rem 0.55rem;
      font-size: 0.76rem;
      font-weight: 700;
      white-space: nowrap;
      display: inline-block;
    }
    :global(.chip-verified) { background: var(--state); color: #ffffff; }
    :global(.chip-reported) { background: var(--attention); color: #ffffff; }
    :global(.chip-derived) { background: var(--surface); color: var(--ink); border: 1px solid var(--line); }
    :global(.chip-inferred) { background: var(--compute); color: #ffffff; }
    :global(.chip-conflict) { background: var(--conflict); color: #ffffff; }
    :global(.chip-unknown) { background: var(--line); color: var(--ink); }

    :global(html[data-theme="dark"]) .vtab.active,
    :global(html[data-theme="dark"]) :global(.chip-verified),
    :global(html[data-theme="dark"]) :global(.chip-reported),
    :global(html[data-theme="dark"]) :global(.chip-inferred),
    :global(html[data-theme="dark"]) :global(.chip-conflict) {
      color: #0b1220;
    }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme="light"])) .vtab.active,
      :global(:root:not([data-theme="light"])) :global(.chip-verified),
      :global(:root:not([data-theme="light"])) :global(.chip-reported),
      :global(:root:not([data-theme="light"])) :global(.chip-inferred),
      :global(:root:not([data-theme="light"])) :global(.chip-conflict) {
        color: #0b1220;
      }
    }

    .compare-chips {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    @media (min-width: 720px) {
      .facts {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .decision-panel .facts {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 821px) {
      .mobile-cards {
        display: none;
      }
    }

    @media (max-width: 900px) {
      /* #36 tablet/mobile readability: put readable vertical cards FIRST and keep full blueprint scrollable at >=12px font */
      .mobile-cards {
        order: -1;
      }
      .stage-footer {
        order: 3;
      }
      .figure-wrap.mode-fit .figure-inner,
      .figure-wrap.mode-fit svg {
        width: 78rem;
        min-width: 78rem;
      }
    }

    @media (max-width: 640px) {
      /* #36 first-screen budget on 390x844: keep Spine + Schedule readable above y=844px */
      .crumb-row {
        margin-bottom: 0.35rem;
        gap: 0.3rem;
      }
      .crumb-meta .pill-license,
      .compare-picker {
        display: none;
