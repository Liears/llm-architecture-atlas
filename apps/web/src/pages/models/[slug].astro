    }
    :global(.cit-card) {
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--panel);
      padding: 0.75rem 0.9rem;
      display: grid;
      gap: 0.38rem;
      box-shadow: var(--shadow-sm);
