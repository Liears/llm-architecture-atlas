---
import Base from "../layouts/Base.astro";
import { loadModels, catalogEntries } from "../lib/atlas.js";
import { buildGenome, genomeCellRole, families, formatParams, formatContext } from "@atlas/catalog";

const models = loadModels();
const entries = catalogEntries(models);
const fams = families(entries);

const byId = new Map(models.map((m, idx) => [m.arch.model.id, { model: m, order: idx }] as const));
const arCount = entries.filter((e) => e.paradigm === "autoregressive_lm").length;
const s1Count = entries.filter((e) => e.paradigm === "system_one_decision").length;

const roleHex: Record<string, string> = {
  attention: "var(--attention)",
  state: "var(--state)",
  compute: "var(--compute)",
  muted: "var(--line)",
};

const cardRows = entries.map((e) => {
  const rec = byId.get(e.id)!;
  const genome = buildGenome(rec.model.arch);
  return { entry: e, order: rec.order, genome };
});

const orderedSlugs = models.map((m) => m.slug);
---

<Base title="LLM Architecture Atlas — catalog" active="catalog">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow" data-i18n="catalog.eyebrow">Evidence-traceable Architecture Atlas</p>
      <h1 data-i18n="catalog.title">Catalog</h1>
      <p class="lead" data-i18n="catalog.subtitle" data-n={String(entries.length)}>
        {entries.length} architectures across two execution paradigms. Every diagram compiles from Architecture IR;
        every scalar fact resolves to a pinned source claim.
      </p>
    </div>

    <div class="hero-stats" aria-label="Atlas telemetry">
      <div class="stat-tile">
        <span class="stat-num mono">{entries.length}</span>
        <span class="stat-label" data-i18n="catalog.statModels">Models indexed</span>
      </div>
      <div class="stat-tile">
        <span class="stat-num mono">2</span>
        <span class="stat-label" data-i18n="catalog.statParadigms">Execution paradigms</span>
      </div>
      <div class="stat-tile">
        <span class="stat-num mono accent-state">0</span>
        <span class="stat-label" data-i18n="catalog.statDebt">Geometry gate debt</span>
      </div>
    </div>
  </section>

  <section class="paradigm-guide" aria-label="Architectural paradigms">
    <div class="paradigm-box ar-box">
      <div class="paradigm-head">
        <span class="pill pill-ar" data-i18n="catalog.badgeAr" data-n={String(arCount)}>System-2 · Autoregressive ({arCount})</span>
      </div>
      <h2 data-i18n="catalog.paradigmArTitle">Autoregressive Generative LLMs</h2>
      <p data-i18n="catalog.paradigmArDesc">
        Predict next tokens sequentially through a causal decoder loop (Prefill + Decode), emitting prose, reasoning chains, or code.
      </p>
    </div>

    <div class="paradigm-box s1-box">
      <div class="paradigm-head">
        <span class="pill pill-s1" data-i18n="catalog.badgeS1" data-n={String(s1Count)}>System-1 · Non-Autoregressive ({s1Count})</span>
      </div>
      <h2 data-i18n="catalog.paradigmS1Title">System-1 Non-Autoregressive Decision Models</h2>
      <p data-i18n="catalog.paradigmS1Desc">
        Skip the token-by-token decode loop. Ingest state + typed queries in one forward pass to emit calibrated probabilities (choice, score, noul).
      </p>
    </div>
  </section>

  <section class="toolbar" aria-label="Catalog filters">
    <div class="paradigm-tabs" role="group" aria-label="Filter by execution paradigm">
      <button type="button" class="ptab active" data-paradigm="" data-i18n="catalog.paradigmAll">All paradigms</button>
      <button type="button" class="ptab" data-paradigm="autoregressive_lm" data-i18n="catalog.paradigmAr">Autoregressive LM (System-2)</button>
      <button type="button" class="ptab" data-paradigm="system_one_decision" data-i18n="catalog.paradigmS1">System-1 Decision (Jev-class)</button>
    </div>

    <div class="controls">
      <input id="q" type="search" placeholder="Search model, family, attention, readout…" data-i18n-placeholder="catalog.search" aria-label="Search models" />
      <select id="family" aria-label="Filter by family" data-i18n-aria="catalog.allFamilies">
        <option value="" data-i18n="catalog.allFamilies">All families</option>
        {fams.map((f) => <option value={f}>{f}</option>)}
      </select>
      <select id="sort" aria-label="Sort" data-i18n-aria="catalog.sortLabel">
        <option value="label" data-i18n="catalog.sortLabel">Sort: name</option>
        <option value="params-desc" data-i18n="catalog.sortParams">Sort: total params ↓</option>
        <option value="layers-desc" data-i18n="catalog.sortLayers">Sort: layers ↓</option>
      </select>
    </div>
  </section>

  <ul id="catalog" data-testid="catalog-list">
    {
      cardRows.map(({ entry: e, order, genome }) => {
        const isS1 = e.paradigm === "system_one_decision";
        return (
          <li
            class={`card ${isS1 ? "card-s1" : "card-ar"}`}
            data-slug={e.slug}
            data-order={String(order)}
            data-label={e.label}
            data-family={e.family}
            data-paradigm={e.paradigm}
            data-params={e.totalParams ?? 0}
            data-layers={e.numLayers}
            data-search={`${e.label} ${e.family} ${e.decoderType} ${e.paradigm} ${e.primitives.join(" ")} ${e.attentionTypes.join(" ")}`.toLowerCase()}
          >
            <div class="card-top">
              <span class={`pill ${isS1 ? "pill-s1" : "pill-ar"}`} data-i18n={isS1 ? "catalog.cardS1" : "catalog.cardAr"}>
                {isS1 ? "System-1 · Decision" : "System-2 · Autoregressive"}
              </span>
              <span class="card-family mono">{e.family}</span>
            </div>

            <div class="card-title-row">
              <a class="card-link" href={`/llm-architecture-atlas/models/${e.slug}/`}>
                <strong>{e.label}</strong>
              </a>
              <p class="card-sub muted">{e.decoderType}</p>
            </div>

            <div class="mini-genome" title={`${e.numLayers}-layer architecture genome`}>
              <svg viewBox={`0 0 ${genome.numLayers * 10} 20`} width="100%" height="18" preserveAspectRatio="none" aria-hidden="true">
                {genome.layers.map((l, idx) => (
                  <g>
                    <rect x={idx * 10 + 1} y="1" width="8" height="11" rx="1.5" fill={roleHex[genomeCellRole(l)]} />
                    <rect x={idx * 10 + 1} y="14" width="8" height="5" rx="1" fill={l.ffnKind === "moe" ? "var(--compute)" : isS1 ? "var(--decision)" : "var(--line)"} />
                  </g>
                ))}
              </svg>
            </div>

            <dl class="card-metrics">
              <div>
                <dt data-i18n="fact.params">Parameters</dt>
                <dd class="mono">
                  {e.totalParams ? formatParams(e.totalParams) : "—"}
                  {e.activeParams && e.activeParams !== e.totalParams && (
                    <> / {formatParams(e.activeParams)}<span data-i18n-en=" act" data-i18n-zh=" 激活"> act</span></>
                  )}
                </dd>
              </div>
              <div>
                <dt data-i18n="fact.layers">Layers</dt>
                <dd class="mono">{e.numLayers}</dd>
              </div>
              <div>
                <dt data-i18n="fact.context">Context</dt>
                <dd class="mono">{formatContext(e.contextTokens)}</dd>
              </div>
            </dl>

            <div class="card-actions">
              <a class="inspect-link" href={`/llm-architecture-atlas/models/${e.slug}/`} data-i18n="catalog.inspect">
                Inspect anatomy →
              </a>
              <button type="button" class="compare-pick btn" data-pick-slug={e.slug} data-pick-label={e.label}>
                <span data-i18n="catalog.compareBtn">Compare</span>
              </button>
            </div>
          </li>
        );
      })
    }
  </ul>

  <p id="empty" class="empty-state" hidden>
    <span data-i18n="catalog.noMatch">No models match the current filters.</span>
    <button type="button" id="reset" class="btn" data-i18n="catalog.reset">Reset filters</button>
  </p>

  <aside id="compare-dock" class="compare-dock" aria-label="Model comparison builder">
    <div class="dock-slots">
      <div class="slot slot-a">
        <span class="slot-tag" data-i18n="catalog.compareA">Slot A</span>
        <strong id="slot-a-label" class="slot-name">—</strong>
      </div>
      <span class="dock-vs mono">vs</span>
      <div class="slot slot-b">
        <span class="slot-tag" data-i18n="catalog.compareB">Slot B</span>
        <strong id="slot-b-label" class="slot-name">—</strong>
      </div>
    </div>
    <div class="dock-actions">
      <span id="dock-hint" class="muted" data-i18n="catalog.compareHint">Select any two models above to compare layer genomes and specs.</span>
      <a id="dock-go" class="btn btn-primary" href="/llm-architecture-atlas/compare/zai-org-glm-5-3-flash--vs--convaiinnovations-laya/" hidden data-i18n="catalog.compareLaunch">
        Open side-by-side diff →
      </a>
    </div>
  </aside>

  <script type="application/json" is:inline id="ordered-slugs" set:html={JSON.stringify(orderedSlugs)}></script>

  <script>
    const q = document.getElementById("q") as HTMLInputElement;
    const family = document.getElementById("family") as HTMLSelectElement;
    const sort = document.getElementById("sort") as HTMLSelectElement;
    const list = document.getElementById("catalog")!;
    const empty = document.getElementById("empty")!;
    const cards = [...list.querySelectorAll<HTMLElement>("li.card")];
    const pTabs = [...document.querySelectorAll<HTMLButtonElement>(".ptab")];
    let activeParadigm = "";

    function applyFromURL() {
      const params = new URLSearchParams(location.search);
      q.value = params.get("q") ?? "";
      family.value = params.get("family") ?? "";
      sort.value = params.get("sort") ?? "label";
      activeParadigm = params.get("paradigm") ?? "";
      pTabs.forEach((b) => b.classList.toggle("active", (b.dataset.paradigm ?? "") === activeParadigm));
      apply();
    }

    function apply() {
      const query = q.value.trim().toLowerCase();
      const fam = family.value;
      let visible = 0;
      for (const card of cards) {
        const okFamily = !fam || card.dataset.family === fam;
        const okParadigm = !activeParadigm || card.dataset.paradigm === activeParadigm;
        const okQuery = !query || (card.dataset.search ?? "").includes(query);
        card.hidden = !(okFamily && okParadigm && okQuery);
        if (!card.hidden) visible++;
      }
      empty.hidden = visible > 0;
      const [key, dir] = sort.value.split("-");
      const desc = dir === "desc";
      const sorted = [...cards].sort((a, b) => {
        const av = key === "label" ? a.dataset.label! : Number(a.dataset[key === "params" ? "params" : "layers"] ?? 0);
        const bv = key === "label" ? b.dataset.label! : Number(b.dataset[key === "params" ? "params" : "layers"] ?? 0);
        const r = typeof av === "string" ? av.localeCompare(bv as string) : (av as number) - (bv as number);
        return desc ? -r : r;
      });
      for (const card of sorted) list.appendChild(card);
      const params = new URLSearchParams();
      if (q.value) params.set("q", q.value);
      if (family.value) params.set("family", family.value);
      if (activeParadigm) params.set("paradigm", activeParadigm);
      if (sort.value !== "label") params.set("sort", sort.value);
      const qLang = new URLSearchParams(location.search).get("lang");
      if (qLang === "zh" || qLang === "en") params.set("lang", qLang);
      history.replaceState(null, "", params.toString() ? `?${params}` : location.pathname);
    }

    pTabs.forEach((btn) =>
      btn.addEventListener("click", () => {
        activeParadigm = btn.dataset.paradigm ?? "";
        pTabs.forEach((b) => b.classList.toggle("active", b === btn));
        apply();
      }),
    );
    q?.addEventListener("input", apply);
    family?.addEventListener("change", apply);
    sort?.addEventListener("change", apply);
    document.getElementById("reset")?.addEventListener("click", () => {
      q.value = "";
      family.value = "";
      activeParadigm = "";
      pTabs.forEach((b) => b.classList.toggle("active", (b.dataset.paradigm ?? "") === ""));
      apply();
    });

    // Two-model compare slot builder
    const orderedSlugs = JSON.parse(document.getElementById("ordered-slugs")!.textContent!) as string[];
    let slotA: { slug: string; label: string } | null = null;
    let slotB: { slug: string; label: string } | null = null;
    const labelA = document.getElementById("slot-a-label")!;
    const labelB = document.getElementById("slot-b-label")!;
    const dockHint = document.getElementById("dock-hint")!;
    const dockGo = document.getElementById("dock-go") as HTMLAnchorElement;

    function syncCompareDock() {
      labelA.textContent = slotA?.label ?? "—";
      labelB.textContent = slotB?.label ?? "—";
      cards.forEach((c) => {
        const s = c.dataset.slug;
        c.dataset.compareSlot = slotA?.slug === s ? "a" : slotB?.slug === s ? "b" : "";
      });
      if (slotA && slotB) {
        const ia = orderedSlugs.indexOf(slotA.slug);
        const ib = orderedSlugs.indexOf(slotB.slug);
        const [first, second] = ia < ib ? [slotA.slug, slotB.slug] : [slotB.slug, slotA.slug];
        dockGo.href = `/llm-architecture-atlas/compare/${first}--vs--${second}/`;
        dockGo.hidden = false;
        dockHint.hidden = true;
      } else {
        dockGo.hidden = true;
        dockHint.hidden = false;
      }
    }

    document.querySelectorAll<HTMLButtonElement>(".compare-pick").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = btn.dataset.pickSlug!;
        const label = btn.dataset.pickLabel!;
        if (slotA?.slug === slug) {
          slotA = null;
        } else if (slotB?.slug === slug) {
          slotB = null;
        } else if (!slotA) {
          slotA = { slug, label };
        } else if (!slotB) {
          slotB = { slug, label };
        } else {
          slotA = slotB;
          slotB = { slug, label };
        }
        syncCompareDock();
      });
    });

    applyFromURL();
    syncCompareDock();
    document.body.dataset.atlasReady = "1";
  </script>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 1fr);
      gap: 1.5rem;
      align-items: end;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--line);
      margin-bottom: 1.25rem;
    }
    .hero h1 {
      margin: 0 0 0.5rem;
      font-size: clamp(2rem, 4vw, 2.75rem);
      line-height: 1.08;
      letter-spacing: -0.03em;
    }
    .lead {
      margin: 0;
      max-width: 42rem;
      font-size: 1.04rem;
      color: var(--muted);
    }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.65rem;
    }
    .stat-tile {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--panel);
      padding: 0.75rem 0.9rem;
      box-shadow: var(--shadow-sm);
      display: grid;
      gap: 0.15rem;
    }
    .stat-num {
      font-size: 1.55rem;
      font-weight: 800;
      line-height: 1.1;
      color: var(--ink);
    }
    .stat-num.accent-state {
      color: var(--state);
    }
    .stat-label {
      font-size: 0.78rem;
      color: var(--muted);
      font-weight: 600;
    }

    .paradigm-guide {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
      margin-bottom: 1.4rem;
    }
    .paradigm-box {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--panel);
      padding: 0.95rem 1.1rem;
      box-shadow: var(--shadow-sm);
    }
    .paradigm-box.ar-box {
      border-left: 4px solid var(--attention);
    }
    .paradigm-box.s1-box {
      border-left: 4px solid var(--decision);
    }
    .paradigm-box h2 {
      margin: 0.45rem 0 0.25rem;
      font-size: 1.02rem;
      letter-spacing: -0.01em;
    }
    .paradigm-box p {
      margin: 0;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .toolbar {
      display: grid;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .paradigm-tabs {
      display: flex;
      gap: 0.45rem;
      flex-wrap: wrap;
    }
    .ptab {
      font: inherit;
      font-size: 0.84rem;
      font-weight: 600;
      padding: 0.38rem 0.85rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--panel);
      color: var(--muted);
      cursor: pointer;
    }
    .ptab:hover {
      border-color: var(--attention);
      color: var(--ink);
    }
    .ptab.active {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }

    .controls {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .controls input {
      flex: 1 1 16rem;
    }
    .controls input,
    .controls select {
      padding: 0.48rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: var(--panel);
      color: var(--ink);
      font: inherit;
      font-size: 0.9rem;
    }

    #catalog {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.95rem;
      grid-template-columns: repeat(auto-fill, minmax(20.5rem, 1fr));
    }
    .card {
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1rem 1.05rem;
      display: grid;
      gap: 0.72rem;
      background: var(--panel);
      box-shadow: var(--shadow-sm);
      transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
    }
    .card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: color-mix(in srgb, var(--attention) 55%, var(--line));
    }
    .card[data-compare-slot="a"] {
      border-color: var(--state);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--state) 22%, transparent);
    }
    .card[data-compare-slot="b"] {
      border-color: var(--compute);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--compute) 22%, transparent);
    }
    .card[hidden] {
      display: none;
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
    }
    .card-family {
      font-size: 0.74rem;
      color: var(--muted);
    }
    .card-link {
      color: var(--ink);
      text-decoration: none;
      font-size: 1.08rem;
      line-height: 1.25;
    }
    .card-link:hover {
      color: var(--attention);
      text-decoration: underline;
    }
    .card-sub {
      margin: 0.2rem 0 0;
      font-size: 0.84rem;
      line-height: 1.35;
    }

    .mini-genome {
      border: 1px solid var(--line);
      border-radius: 7px;
      background: var(--surface);
      padding: 0.3rem 0.35rem;
      line-height: 0;
    }
    .mini-genome svg {
      display: block;
      width: 100%;
    }

    .card-metrics {
      margin: 0;
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.72fr) minmax(0, 0.78fr);
      gap: 0.45rem;
      padding-top: 0.45rem;
      border-top: 1px solid var(--line-soft);
    }
    .card-metrics > div {
      min-width: 0;
    }
    .card-metrics dt {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .card-metrics dd {
      margin: 0.08rem 0 0;
      font-size: 0.81rem;
      font-weight: 700;
    }

    .card-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.6rem;
      padding-top: 0.2rem;
    }
    .inspect-link {
      font-size: 0.86rem;
      font-weight: 700;
      text-decoration: none;
    }
    .inspect-link:hover {
      text-decoration: underline;
    }
    .compare-pick {
      padding: 0.28rem 0.65rem;
      font-size: 0.78rem;
    }

    .empty-state {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1.25rem;
      border: 1px dashed var(--line);
      border-radius: 12px;
      background: var(--panel);
    }
    .empty-state[hidden] {
      display: none;
    }

    .compare-dock {
      margin-top: 1.5rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--panel);
      padding: 0.9rem 1.1rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .dock-slots {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }
    .slot {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.3rem 0.65rem;
      border-radius: 8px;
      background: var(--surface);
      border: 1px solid var(--line);
      font-size: 0.84rem;
    }
    .slot-a {
      border-left: 3px solid var(--state);
    }
    .slot-b {
      border-left: 3px solid var(--compute);
    }
    .slot-tag {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted);
      text-transform: uppercase;
    }
    .dock-vs {
      font-size: 0.82rem;
      color: var(--muted);
    }
    .dock-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      font-size: 0.86rem;
    }

    @media (max-width: 820px) {
      .hero {
        grid-template-columns: 1fr;
      }
      .paradigm-guide {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 480px) {
      .hero-stats {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .stat-tile {
        padding: 0.55rem 0.6rem;
      }
      .stat-num {
        font-size: 1.25rem;
      }
      #catalog {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
