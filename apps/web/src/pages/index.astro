---
import Base from "../layouts/Base.astro";
import { loadModels, catalogEntries } from "../lib/atlas.js";
import { families } from "@atlas/catalog";

const models = loadModels();
const entries = catalogEntries(models);
const fams = families(entries);

const fmtB = (n: number | null): string => {
  if (n === null) return "—";
  const b = Math.round((n / 1e9) * 10) / 10;
  return `${Number.isInteger(b) ? b.toFixed(0) : b.toFixed(1)}B`;
};
---

<Base title="LLM Architecture Atlas — catalog">
  <p class="eyebrow">Evidence-traceable LLM architecture atlas</p>
  <h1 data-i18n="catalog.title">Catalog</h1>
  <p data-i18n="catalog.subtitle" data-n={String(entries.length)}>
    {entries.length} models. Every figure is generated from an Architecture IR;
    every number traces to an evidence claim.
  </p>

  <div class="controls">
    <input id="q" type="search" placeholder="Search label, family, attention…" data-i18n-placeholder="catalog.search" aria-label="Search models" />
    <select id="family" aria-label="Filter by family" data-i18n-aria="catalog.allFamilies">
      <option value="" data-i18n="catalog.allFamilies">All families</option>
      {fams.map((f) => <option value={f}>{f}</option>)}
    </select>
    <select id="sort" aria-label="Sort" data-i18n-aria="catalog.sortLabel">
      <option value="label" data-i18n="catalog.sortLabel">Sort: label</option>
      <option value="params-desc" data-i18n="catalog.sortParams">Sort: total params ↓</option>
      <option value="layers-desc" data-i18n="catalog.sortLayers">Sort: layers ↓</option>
    </select>
  </div>

  <ul id="catalog" data-testid="catalog-list">
    {
      entries.map((e) => (
        <li
          class="card"
          data-label={e.label}
          data-family={e.family}
          data-params={e.totalParams ?? 0}
          data-layers={e.numLayers}
          data-search={`${e.label} ${e.family} ${e.decoderType} ${e.attentionTypes.join(" ")}`.toLowerCase()}
        >
          <a href={`/llm-architecture-atlas/models/${e.slug}/`}>
            <strong>{e.label}</strong>
          </a>
          <span class="muted">{e.family} · {e.decoderType}</span>
          <span class="muted">
            {e.totalParams ? `${fmtB(e.totalParams)} total` : "—"}
            {e.activeParams && e.activeParams !== e.totalParams ? ` / ${fmtB(e.activeParams)} active` : ""}
            {" · "}{e.numLayers} layers
            {e.contextTokens ? ` · ${e.contextTokens >= 1e6 ? `${Math.round((e.contextTokens / 1e5)) / 10}M` : Math.round(e.contextTokens / 1024) + "K"} ctx` : ""}
          </span>
        </li>
      ))
    }
  </ul>
  <p id="empty" hidden><span data-i18n="catalog.noMatch">No models match.</span> <button type="button" id="reset" data-i18n="catalog.reset">Reset filters</button></p>

  <p>
    <a href="/llm-architecture-atlas/concepts/" data-i18n="nav.concepts">Concepts</a> ·
    <a href="/llm-architecture-atlas/compare/zai-org-glm-5-3-flash--vs--meta-llama-llama-3-8b/" data-i18n="nav.compare">Example comparison</a> ·
    <a href="/llm-architecture-atlas/changes.xml" data-i18n="nav.changes">Changes (RSS)</a> ·
    <a href="https://github.com/Liears/llm-architecture-atlas" data-i18n="nav.source">Source & issues</a>
  </p>

  <script>
    const q = document.getElementById("q") as HTMLInputElement;
    const family = document.getElementById("family") as HTMLSelectElement;
    const sort = document.getElementById("sort") as HTMLSelectElement;
    const list = document.getElementById("catalog")!;
    const empty = document.getElementById("empty")!;
    const cards = [...list.querySelectorAll<HTMLElement>("li")];

    function applyFromURL() {
      const params = new URLSearchParams(location.search);
      q.value = params.get("q") ?? "";
      family.value = params.get("family") ?? "";
      sort.value = params.get("sort") ?? "label";
      apply();
    }

    function apply() {
      const query = q.value.trim().toLowerCase();
      const fam = family.value;
      let visible = 0;
      for (const card of cards) {
        const okFamily = !fam || card.dataset.family === fam;
        const okQuery = !query || (card.dataset.search ?? "").includes(query);
        card.hidden = !(okFamily && okQuery);
        if (!card.hidden) visible++;
      }
      empty.hidden = visible > 0;
      const [key, dir] = sort.value.split("-");
      const desc = dir === "desc";
      const sorted = [...cards].sort((a, b) => {
        const av = key === "label" ? a.dataset.label! : Number(a.dataset[key === "params" ? "params" : "layers"] ?? 0);
        const bv = key === "label" ? b.dataset.label! : Number(b.dataset[key === "params" ? "params" : "layers"] ?? 0);
        const r = typeof av === "string" ? av.localeCompare(bv as string) : (av as number) - (bv as number);
        return desc ? -r : r;
      });
      for (const card of sorted) list.appendChild(card);
      const params = new URLSearchParams();
      if (q.value) params.set("q", q.value);
      if (family.value) params.set("family", family.value);
      if (sort.value !== "label") params.set("sort", sort.value);
      history.replaceState(null, "", params.toString() ? `?${params}` : location.pathname);
    }

    q?.addEventListener("input", apply);
    family?.addEventListener("change", apply);
    sort?.addEventListener("change", apply);
    document.getElementById("reset")?.addEventListener("click", () => {
      q.value = ""; family.value = ""; apply();
    });
    applyFromURL();
    document.body.dataset.atlasReady = "1";
  </script>

  <style>
    .controls { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 1rem 0 1.4rem; }
    .controls input, .controls select {
      padding: 0.45rem 0.7rem; border: 1px solid var(--line); border-radius: 8px;
      background: var(--panel); color: inherit; font: inherit;
    }
    #catalog { list-style: none; padding: 0; display: grid; gap: 0.7rem; grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr)); }
    .card { border: 1px solid var(--line); border-radius: 10px; padding: 0.8rem 1rem; display: grid; gap: 0.15rem; background: var(--panel); }
    .card[hidden] { display: none; }
    .card a { text-decoration: none; }
    .card a:hover { text-decoration: underline; }
    .muted { color: var(--muted); font-size: 0.88rem; }
    #empty button { font: inherit; cursor: pointer; }
  </style>
</Base>
