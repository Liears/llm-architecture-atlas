{
  "name": "llm-architecture-atlas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @atlas/web build && pnpm --filter @atlas/web test:e2e",
    "pytest": "pytest tools/ingest",
    "export:golden": "tsx scripts/export-golden.ts",
    "verify": "node scripts/verify.mjs",
    "verify:e2e": "node scripts/verify.mjs --e2e",
    "test:debt": "tsx scripts/debt-check.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@img/sharp"
    ]
  }
}
